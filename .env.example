# Copy to .env.local for the Next.js app and the analysis worker.
# The first three keys belong in the private auto24.env file outside this
# repository, which docker compose reads; the app ignores them.
PUBLIC_API_KEY=
INTERNAL_API_KEY=
# Default binds only to localhost. Change only if you intend remote access.
API_BIND=127.0.0.1:8000

# Next.js dashboard server only. Never prefix these with NEXT_PUBLIC_.
AUTO24_SERVICE_URL=http://127.0.0.1:8000
AUTO24_SERVICE_API_KEY=
# Generate an independent random secret of at least 32 characters.
ANALYSIS_COOKIE_SECRET=

# Private analysis persistence and worker. Supabase URL identifies the service;
# the role key stays server-only. Keep the existing database when applying migrations.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
AUTO24_FETCH_ENABLED=true
WORKER_ID=checkpoint-2-worker
OPENAI_API_KEY=

# Developer-only reviewer controls; blank optional overrides inherit defaults.
DATA_REVIEW_ENABLED=true
DATA_REVIEW_MODE=split
DATA_REVIEW_PROVIDER=codex
# Canonical model; OPENAI_INSIGHT_MODEL is only a compatibility fallback.
DATA_REVIEW_MODEL=gpt-6-luna
DATA_REVIEW_REASONING_EFFORT=xhigh
# In split mode only; final synthesis uses resolved text settings.
DATA_REVIEW_TEXT_PROVIDER=
DATA_REVIEW_TEXT_MODEL=
DATA_REVIEW_TEXT_REASONING_EFFORT=
DATA_REVIEW_IMAGE_PROVIDER=codex
DATA_REVIEW_IMAGE_MODEL=gpt-6-luna
DATA_REVIEW_IMAGE_REASONING_EFFORT=xhigh
# Exact-ID developer assertions, never request input. Unknown IDs are unavailable.
# The production image pass requires an explicit codex/gpt-6-luna declaration
# including xhigh. Declare only capabilities available to the logged-in account.
# Shape: {"openai":{"your-model":{"responses":true,"text":true,"structuredOutput":true,"imageInput":true,"efforts":["low","high"]}}}
# Approved production image capability declaration:
DATA_REVIEW_CAPABILITIES={"codex":{"gpt-6-luna":{"responses":false,"text":true,"structuredOutput":true,"imageInput":true,"efforts":["xhigh"]}}}

# DATA_REVIEW_PROVIDER=codex uses `codex login` instead of OPENAI_API_KEY.
# For OpenAI, set the provider to openai, set OPENAI_API_KEY and declare the
# model under the openai key. Point the command at an installed executable if
# codex is not on PATH.
DATA_REVIEW_CODEX_COMMAND=codex
# Example declaration after verifying this model in your Codex account:
# {"codex":{"gpt-6.1-sol":{"responses":false,"text":true,"structuredOutput":true,"imageInput":true,"efforts":["medium"]}}}

# Private live review diagnostics (server-only; default off)
LIVE_DIAGNOSTICS_ENABLED=false
