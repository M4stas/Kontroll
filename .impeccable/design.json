  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "A main action or a quieter alternative.",
      "html": "<button class=\"ds-button-primary\">Open the report</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:0;border-radius:999px;font:600 15px Geist,system-ui,sans-serif;cursor:pointer;transition:transform .35s cubic-bezier(.34,1.3,.64,1),background .25s;background:var(--accent);color:var(--accent-text);} .ds-button-primary:hover{transform:translateY(-1px);} .ds-button-primary:active{transform:scale(.98);} .ds-button-primary:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;} .ds-button-primary:disabled{opacity:.5;cursor:default;transform:none;} @media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}.ds-button-primary:hover,.ds-button-primary:active{transform:none;}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A main action or a quieter alternative.",
      "html": "<button class=\"ds-button-secondary\">Continue manually</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border:0;border-radius:999px;font:600 15px Geist,system-ui,sans-serif;cursor:pointer;transition:transform .35s cubic-bezier(.34,1.3,.64,1),background .25s;background:var(--surface-2);color:var(--text);} .ds-button-secondary:hover{transform:translateY(-1px);} .ds-button-secondary:active{transform:scale(.98);} .ds-button-secondary:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;} .ds-button-secondary:disabled{opacity:.5;cursor:default;transform:none;} @media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}.ds-button-secondary:hover,.ds-button-secondary:active{transform:none;}}"
    },
    {
      "name": "Address field",
      "kind": "input",
      "refersTo": "input-url",
      "description": "The listing address entry uses a quiet surface and an accent focus state.",
      "html": "<label class=\"ds-field-label\" for=\"ds-url\">Auto24 listing address</label><input id=\"ds-url\" class=\"ds-address\" placeholder=\"https://www.auto24.ee/soidukid/…\">",
      "css": ".ds-field-label{display:block;font:600 14px Geist,system-ui,sans-serif;margin-bottom:8px;color:var(--text);} .ds-address{width:100%;min-height:48px;padding:0 16px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--text);font:16px Geist,system-ui,sans-serif;} .ds-address::placeholder{color:var(--text-2);} .ds-address:hover{border-color:var(--text-2);} .ds-address:focus-visible{border-color:var(--accent);outline:2px solid var(--accent,#3050d0);outline-offset:3px;} .ds-address[aria-invalid=\"true\"]{border-color:var(--attention);}"
    },
    {
      "name": "Header navigation",
      "kind": "nav",
      "description": "Brand, new listing and language selection share a quiet horizontal header that sticks on wider screens and scrolls away on phones.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><a class=\"ds-brand\" href=\"#\">Kontroll</a><span class=\"ds-nav-actions\"><a href=\"#\">New listing</a><a href=\"#\" lang=\"et\">ET</a><a href=\"#\" lang=\"en\" aria-current=\"page\">EN</a></span></nav>",
      "css": ".ds-nav{display:flex;align-items:center;justify-content:space-between;gap:18px;min-height:64px;border-bottom:1px solid var(--line);font-family:Geist,system-ui,sans-serif;} .ds-nav a{display:inline-flex;min-height:44px;align-items:center;text-decoration:none;color:var(--text-2);} .ds-nav .ds-brand{font-size:17px;font-weight:650;color:var(--text);} .ds-nav-actions{display:flex;gap:14px;font-size:13px;} .ds-nav a:hover,.ds-nav a[aria-current]{color:var(--text);} .ds-nav a:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;}"
    },
    {
      "name": "Equipment tag",
      "kind": "chip",
      "refersTo": "equipment-tag",
      "description": "A small static listing fact.",
      "html": "<span class=\"ds-tag\">Cruise control</span>",
      "css": ".ds-tag{display:inline-flex;padding:5px 8px;border:1px solid var(--line);border-radius:3px;color:var(--text);font:400 12px/1.45 Geist,system-ui,sans-serif;}"
    },
    {
      "name": "Finding card",
      "kind": "card",
      "refersTo": "report-card",
      "description": "A visual half and a readable explanation, with a source action.",
      "html": "<article class=\"ds-finding\"><div class=\"ds-finding-visual\"><svg width=\"96\" height=\"96\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\" aria-hidden=\"true\"><path d=\"M5 17v2m14-2v2M4 9l2-5h12l2 5M3 10h18v7H3zM6 13h2m8 0h2\"/></svg></div><div class=\"ds-finding-copy\"><p class=\"ds-area\">Mechanical &amp; servicing</p><h2>Service history is claimed but not documented</h2><p>The listing mentions a service book, but no dated pages are visible.</p><button>Seller claim</button></div></article>",
      "css": ".ds-finding{display:grid;grid-template-columns:1.05fr 1fr;border-radius:28px;background:var(--surface);box-shadow:var(--shadow);overflow:hidden;font-family:Geist,system-ui,sans-serif;color:var(--text);} .ds-finding-visual{display:grid;place-items:center;min-height:280px;background:var(--surface-2);color:var(--text-2);} .ds-finding-copy{padding:32px;display:flex;flex-direction:column;gap:14px;justify-content:center;min-width:0;} .ds-finding-copy p{margin:0;color:var(--text-2);font-size:17px;line-height:1.65;} .ds-finding-copy .ds-area{font-size:14px;font-weight:600;color:var(--accent);} .ds-finding h2{margin:0;font-size:30px;line-height:1.08;letter-spacing:-.04em;overflow-wrap:anywhere;} .ds-finding button{align-self:start;min-height:44px;border:0;padding:8px 0;background:none;color:var(--accent);text-decoration:underline;text-underline-offset:4px;cursor:pointer;} .ds-finding button:hover{color:var(--text);} .ds-finding button:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;} @media(max-width:800px){.ds-finding{grid-template-columns:1fr;}}"
    },
    {
      "name": "Evidence row",
      "kind": "custom",
      "description": "Related report updates wrap into a single band below the cards.",
      "html": "<section class=\"ds-evidence\"><span>Seller replied or new photos?</span><button>Add to the report</button><label>Taustakontroll PDF <input type=\"file\" accept=\"application/pdf\"></label></section>",
      "css": ".ds-evidence{display:flex;flex-wrap:wrap;align-items:center;gap:16px 24px;padding:20px 0;border-block:1px solid var(--line);color:var(--text);font:14px Geist,system-ui,sans-serif;} .ds-evidence button{min-height:44px;border:1px solid var(--line);border-radius:14px;padding:10px 16px;background:var(--surface);color:var(--text);cursor:pointer;} .ds-evidence button:hover{background:var(--surface-2);} .ds-evidence label{display:flex;flex-wrap:wrap;align-items:center;gap:8px;} .ds-evidence input{min-height:44px;max-width:100%;} .ds-evidence button:focus-visible,.ds-evidence input:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;}"
    },
    {
      "name": "Full report disclosure",
      "kind": "custom",
      "description": "The closed disclosure keeps all findings and evidence available.",
      "html": "<details class=\"ds-full-report\"><summary>Full report</summary><section><h3>Mechanical &amp; servicing</h3><p>Every saved observation and its sources stays available here.</p></section></details>",
      "css": ".ds-full-report{padding:16px 0;color:var(--text);font-family:Geist,system-ui,sans-serif;} .ds-full-report summary{min-height:44px;padding:12px 0;font-size:18px;font-weight:600;cursor:pointer;} .ds-full-report summary:hover{color:var(--accent);} .ds-full-report summary:focus-visible{outline:2px solid var(--accent,#3050d0);outline-offset:3px;} .ds-full-report section{margin-top:12px;padding:4px 20px 16px;border-radius:20px;background:var(--surface);} .ds-full-report p{color:var(--text-2);line-height:1.65;}"
    },
    {
      "name": "Review bars",
      "kind": "custom",
      "description": "Three steps follow real listing, photo and final-review progress; each bar sits above its label, and the steps stack on phones.",
      "html": "<ol class=\"ds-review-steps\"><li><span class=\"ds-review-bar\" style=\"--f:1\"></span><b>Read listing</b><span>Listing checked</span></li><li><span class=\"ds-review-bar\" style=\"--f:.5\"></span><b>Review photos</b><span>2 of 4 reviewed</span></li><li data-state=\"warning\"><span class=\"ds-review-bar\" style=\"--f:0\"></span><b>Write review</b><span>Not started</span></li></ol>",
      "css": ".ds-review-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:0;padding:0;list-style:none;font:14px Geist,system-ui,sans-serif;color:var(--text);}.ds-review-steps>li{min-width:0;}.ds-review-bar{display:block;height:6px;margin:0 0 8px;border-radius:999px;background:var(--surface-2);position:relative;overflow:hidden;}.ds-review-bar::after{content:\"\";position:absolute;inset:0;background:var(--accent);transform:scaleX(var(--f,0));transform-origin:left;transition:transform .6s cubic-bezier(.16,1,.3,1);}.ds-review-steps b{display:block;font-weight:600;}.ds-review-steps>li>span:not(.ds-review-bar){color:var(--text-2);}.ds-review-steps [data-state=\"warning\"] b{color:var(--attention);}@media(max-width:639px){.ds-review-steps{grid-template-columns:minmax(0,1fr);gap:20px;overflow-wrap:anywhere;}}@media(max-width:560px){.ds-review-steps{font-size:13px;}}@media(prefers-reduced-motion:reduce){.ds-review-bar::after{transition:none;}}"
    },
    {
      "name": "Review photo tiles",
      "kind": "custom",
      "description": "Waiting photos shimmer; unavailable and unselected photos use labels.",
      "html": "<ul class=\"ds-photo-grid\"><li class=\"ds-photo-wait\" aria-label=\"Photo 1: Waiting for review\"></li><li class=\"ds-photo-unavailable\">Review unavailable</li><li>Not selected</li><li class=\"ds-photo-wait\" aria-label=\"Photo 4: Review in progress\"></li></ul>",
      "css": ".ds-photo-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;list-style:none;padding:0;}.ds-photo-grid li{aspect-ratio:4/3;position:relative;display:grid;place-items:center;overflow:hidden;border-radius:14px;background:var(--surface-2);color:var(--text-2);font:14px Geist,system-ui,sans-serif;text-align:center;}.ds-photo-grid .ds-photo-unavailable{color:var(--attention);}.ds-photo-wait::before{content:\"\";position:absolute;inset:0;background:linear-gradient(100deg,transparent 30%,color-mix(in srgb,var(--surface) 70%,transparent) 50%,transparent 70%);background-size:200% 100%;animation:ds-shimmer 1.4s linear infinite;}@keyframes ds-shimmer{to{background-position:-200% 0;}}@media(max-width:639px){.ds-photo-grid{grid-template-columns:repeat(2,minmax(0,1fr));}}@media(prefers-reduced-motion:reduce){.ds-photo-wait::before{animation:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Evidence at hand",
    "overview": "Kontroll gives a buyer a calm place to read a listing, inspect its photos and carry the resulting questions to a viewing. Light surfaces, generous type and a single blue accent make the evidence easy to find. Dark mode uses the same hierarchy and geometry with a darker set of surfaces.",
    "keyCharacteristics": [
      "Large, direct headings and readable explanations.",
      "Real listing photos, with an area icon when a finding has no photo.",
      "Rounded surfaces, quiet rules and soft elevation.",
      "One accent for actions, progress and evidence links; an attention color for stopped work and unavailable information.",
      "The same interface structure in Estonian and English."
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "Every finding remains available on a card or in the Full report. Presentation never replaces the underlying observation.",
        "section": "overview"
      },
      {
        "name": "The Role Rule",
        "body": "Use `--accent` for an action or an evidence connection and `--attention` for a state that needs the buyer's attention. Use `--text-2` for supporting copy, not for conclusions that must be read.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "Keep explanations intact, with a comfortable measure of up to 65 characters where the component allows it. Do not truncate a saved finding to make a card shorter.",
        "section": "typography"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use the existing shared shadow for a raised surface. Inside a report section, use tone and spacing before adding another elevated container.",
        "section": "elevation & depth"
      },
      {
        "name": "The Reachable Result Rule",
        "body": "A stopped or stale run must leave the report available. A disabled button communicates ongoing work, never a permanent dead end.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the shared role tokens in both themes.",
      "Do keep every saved finding and its evidence reachable.",
      "Do use real listing photos and Phosphor icons for missing visuals.",
      "Do preserve report-language attributes while translating interface strings in both message files.",
      "Do keep actions at least 44px tall with visible keyboard focus.",
      "Do stop review motion when reduced motion is requested."
    ],
    "donts": [
      "Don't reintroduce the folding activity journal.",
      "Don't load a waiting or unavailable photo in the review grid.",
      "Don't enable Open the report during queued, running or checking progress.",
      "Don't leave stopped or stale reviews behind a disabled report button.",
      "Don't use a score, a decorative metric or a fabricated claim in place of evidence.",
      "Don't clip long findings or hide observations to make the card row fit."
    ]
  }
}
