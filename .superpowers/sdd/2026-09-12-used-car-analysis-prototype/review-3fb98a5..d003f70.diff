@@ -0,0 +1,75 @@
+import { describe, expect, it, vi } from "vitest";
+import { addSubmission } from "@/features/supplements/add-submission";
+
+describe("addSubmission", () => {
+  it("queues image enrichment and assembly without recapturing the listing", async () => {
+    const jobs = { enqueueMany: vi.fn().mockResolvedValue({ runId: "run-1", queuedStages: [], created: true }) };
+    const result = await addSubmission({ kind: "image", analysisId: "analysis-1", storageKey: "private/photo.webp" } as never, { jobs } as never);
+    expect(result.queuedStages).toEqual(["enrich", "assemble_report"]);
+    expect(result.queuedStages).not.toContain("capture_listing");
+  });
+
+  it.each([
+    ["seller_answer", ["baseline_checks", "enrich", "assemble_report"]],
+    ["screenshot", ["enrich", "assemble_report"]],
+    ["document", ["baseline_checks", "enrich", "assemble_report"]],
+  ] as const)("queues only affected stages for %s", async (kind, expected) => {
+    const jobs = { enqueueMany: vi.fn().mockResolvedValue({ runId: "run-1", queuedStages: [], created: true }) };
+
+    const result = await addSubmission({
+      analysisId: "analysis-1",
+      idempotencyKey: "11111111-1111-4111-8111-111111111111",
+      kind,
+      ...(kind === "seller_answer" ? { textContent: "Timing belt changed." } : { storageKey: "private/item" }),
+    } as never, { jobs } as never);
+
+    expect(result.queuedStages).toEqual(expected);
+  });
+
+  it("queues identity-dependent stages for a VIN correction", async () => {
+    const jobs = { enqueueMany: vi.fn().mockResolvedValue({ runId: "run-1", queuedStages: [], created: true }) };
+
+    const result = await addSubmission({
+      analysisId: "analysis-1",
+      idempotencyKey: "11111111-1111-4111-8111-111111111111",
+      kind: "seller_answer",
+      textContent: "Correct VIN: WBA12345678901234",
+      identityCorrection: "vin",
+    } as never, { jobs } as never);
+
+    expect(result.queuedStages).toEqual([
+      "normalize_identity",
+      "baseline_checks",
+      "research",
+      "enrich",
+      "assemble_report",
+    ]);
+  });
+
+  it("rejects seller answer text over 10,000 characters before persistence", async () => {
+    const jobs = { enqueueMany: vi.fn().mockResolvedValue({ runId: "run-1", queuedStages: [], created: true }) };
+
+    await expect(addSubmission({
+      analysisId: "analysis-1",
+      idempotencyKey: "11111111-1111-4111-8111-111111111111",
+      kind: "seller_answer",
+      textContent: "x".repeat(10_001),
+    } as never, { jobs } as never)).rejects.toThrow("10,000");
+    expect(jobs.enqueueMany).not.toHaveBeenCalled();
+  });
+
+  it("rejects more than eight files before persistence", async () => {
+    const jobs = { enqueueMany: vi.fn().mockResolvedValue({ runId: "run-1", queuedStages: [], created: true }) };
+
+    await expect(addSubmission({
+      analysisId: "analysis-1",
+      idempotencyKey: "11111111-1111-4111-8111-111111111111",
+      items: Array.from({ length: 9 }, (_, index) => ({
+        kind: "image",
+        storageKey: `analysis/file-${index}.webp`,
+        mimeType: "image/webp",
+      })),
+    } as never, { jobs } as never)).rejects.toThrow("eight files");
+    expect(jobs.enqueueMany).not.toHaveBeenCalled();
+  });
+});
diff --git a/tests/unit/supplements/route.test.ts b/tests/unit/supplements/route.test.ts
new file mode 100644
index 0000000..fc58e6e
--- /dev/null
+++ b/tests/unit/supplements/route.test.ts
@@ -0,0 +1,102 @@
+import { NextRequest } from "next/server";
+import { describe, expect, it, vi } from "vitest";
+import { createSubmissionHandler } from "@/app/api/analyses/[publicId]/submissions/route";
+
+const PUBLIC_ID = "22222222-2222-4222-8222-222222222222";
+const ANALYSIS_ID = "11111111-1111-4111-8111-111111111111";
+
+function context() {
+  return { params: Promise.resolve({ publicId: PUBLIC_ID }) };
+}
+
+function requestWithForm(form: FormData) {
+  return {
+    cookies: { get: vi.fn().mockReturnValue({ value: "private-cookie" }) },
+    formData: vi.fn().mockResolvedValue(form),
+  } as never;
+}
+
+describe("POST /api/analyses/[publicId]/submissions", () => {
+  it("verifies access before reading multipart files or loading the analysis", async () => {
+    const request = new NextRequest(`http://localhost/api/analyses/${PUBLIC_ID}/submissions`, {
+      method: "POST",
+      body: new FormData(),
+    });
+    const formData = vi.spyOn(request, "formData");
+    const loadAnalysisId = vi.fn();
+    const handler = createSubmissionHandler({
+      verifyAccess: vi.fn().mockResolvedValue(false),
+      loadAnalysisId,
+      uploads: {} as never,
+      addSubmission: vi.fn(),
+    });
+
+    const response = await handler(request, context());
+
+    expect(response.status).toBe(401);
+    expect(formData).not.toHaveBeenCalled();
+    expect(loadAnalysisId).not.toHaveBeenCalled();
+  });
+
+  it("returns processing state without exposing storage keys or signed URLs", async () => {
+    const body = new FormData();
+    body.set("idempotencyKey", "33333333-3333-4333-8333-333333333333");
+    body.set("sellerAnswer", "The timing belt was changed in 2024.");
+    body.append("files", new File([new Uint8Array([1, 2, 3])], "service.jpg", { type: "image/jpeg" }));
+    const request = requestWithForm(body);
+    const remove = vi.fn();
+    const handler = createSubmissionHandler({
+      verifyAccess: vi.fn().mockResolvedValue(true),
+      loadAnalysisId: vi.fn().mockResolvedValue(ANALYSIS_ID),
+      uploads: {
+        upload: vi.fn().mockResolvedValue({
+          storageKey: `${ANALYSIS_ID}/private-photo.jpg`,
+          mimeType: "image/jpeg",
+          size: 3,
+        }),
+        remove,
+      } as never,
+      addSubmission: vi.fn().mockResolvedValue({
+        runId: "44444444-4444-4444-8444-444444444444",
+        queuedStages: ["baseline_checks", "enrich", "assemble_report"],
+        created: true,
+      }),
+    });
+
+    const response = await handler(request, context());
+    const payload = await response.json();
+
+    expect(response.status).toBe(202);
+    expect(payload).toEqual({
+      runId: "44444444-4444-4444-8444-444444444444",
+      queuedStages: ["baseline_checks", "enrich", "assemble_report"],
+      files: [{ type: "image/jpeg", state: "processing" }],
+    });
+    expect(JSON.stringify(payload)).not.toContain(ANALYSIS_ID);
+    expect(JSON.stringify(payload)).not.toContain("http");
+    expect(remove).not.toHaveBeenCalled();
+  });
+
+  it("removes newly uploaded private objects when database persistence fails", async () => {
+    const body = new FormData();
+    body.set("idempotencyKey", "33333333-3333-4333-8333-333333333333");
+    body.append("files", new File([new Uint8Array([1, 2, 3])], "service.pdf", { type: "application/pdf" }));
+    const request = requestWithForm(body);
+    const storageKey = `${ANALYSIS_ID}/private-document.pdf`;
+    const remove = vi.fn().mockResolvedValue(undefined);
+    const handler = createSubmissionHandler({
+      verifyAccess: vi.fn().mockResolvedValue(true),
+      loadAnalysisId: vi.fn().mockResolvedValue(ANALYSIS_ID),
+      uploads: {
+        upload: vi.fn().mockResolvedValue({ storageKey, mimeType: "application/pdf", size: 3 }),
+        remove,
+      } as never,
+      addSubmission: vi.fn().mockRejectedValue(new Error("database unavailable")),
+    });
+
+    const response = await handler(request, context());
+
+    expect(response.status).toBe(500);
+    expect(remove).toHaveBeenCalledWith(ANALYSIS_ID, [storageKey]);
+  });
+});
