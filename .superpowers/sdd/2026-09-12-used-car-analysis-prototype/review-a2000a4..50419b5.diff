--- /dev/null
+++ b/src/features/offline/register-worker.tsx
@@ -0,0 +1,41 @@
+"use client";
+
+import { useEffect } from "react";
+
+function bounded<T>(operation: Promise<T>): Promise<T | null> {
+  let timer: ReturnType<typeof setTimeout>;
+  return Promise.race([
+    operation.catch(() => null),
+    new Promise<null>((resolve) => { timer = setTimeout(() => resolve(null), 2500); }),
+  ]).finally(() => clearTimeout(timer));
+}
+
+export async function messageWorker(type: "CACHE_REPORT_SHELL" | "CLEAR_REPORT_SHELL", path: string) {
+  if (!("serviceWorker" in navigator)) return false;
+  const registration = await bounded(navigator.serviceWorker.ready);
+  const active = registration?.active;
+  if (!active) return false;
+  const channel = new MessageChannel();
+  const reply = new Promise<boolean>((resolve) => {
+    channel.port1.onmessage = (event: MessageEvent<boolean>) => resolve(event.data);
+  });
+  try {
+    const assets = performance.getEntriesByType("resource")
+      .map((entry) => new URL(entry.name).pathname)
+      .filter((pathname) => pathname.startsWith("/_next/static/"));
+    active.postMessage({ type, path, assets }, [channel.port2]);
+    return await bounded(reply) ?? false;
+  } catch {
+    return false;
+  } finally {
+    channel.port1.close();
+    channel.port2.close();
+  }
+}
+
+export function RegisterWorker() {
+  useEffect(() => {
+    if ("serviceWorker" in navigator) void navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => undefined);
+  }, []);
+  return null;
+}
diff --git a/src/features/offline/report-cache.ts b/src/features/offline/report-cache.ts
new file mode 100644
index 0000000..a377a2a
--- /dev/null
+++ b/src/features/offline/report-cache.ts
@@ -0,0 +1,117 @@
+import type { AnalysisReport } from "@/domain/analysis";
+import { AnalysisReportSchema } from "@/domain/schemas";
+
+interface OfflineRecord {
+  publicId: string;
+  report: AnalysisReport;
+  checklist: string[];
+}
+
+const DATABASE = "kontroll-offline-report";
+const STORE = "reports";
+let pendingMutation: Promise<void> = Promise.resolve();
+
+function orderedMutation(work: () => Promise<void>): Promise<void> {
+  const result = pendingMutation.then(work);
+  pendingMutation = result.catch(() => undefined);
+  return result;
+}
+
+function database(): Promise<IDBDatabase> {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DATABASE, 1);
+    request.onupgradeneeded = () => request.result.createObjectStore(STORE, { keyPath: "publicId" });
+    request.onsuccess = () => resolve(request.result);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+async function read(publicId: string): Promise<OfflineRecord | null> {
+  const db = await database();
+  try {
+    return await new Promise((resolve, reject) => {
+      const request = db.transaction(STORE, "readonly").objectStore(STORE).get(publicId);
+      request.onsuccess = () => resolve((request.result as OfflineRecord | undefined) ?? null);
+      request.onerror = () => reject(request.error);
+    });
+  } finally {
+    db.close();
+  }
+}
+
+export async function cacheReport(publicId: string, report: AnalysisReport): Promise<void> {
+  const validated = AnalysisReportSchema.parse(report);
+  if (validated.publicId !== publicId) throw new Error("Report ID mismatch");
+  await orderedMutation(async () => {
+    const db = await database();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        const transaction = db.transaction(STORE, "readwrite");
+        transaction.oncomplete = () => resolve();
+        transaction.onerror = () => reject(transaction.error);
+        transaction.onabort = () => reject(transaction.error);
+        const store = transaction.objectStore(STORE);
+        const previous = store.get(publicId);
+        previous.onsuccess = () => {
+          const checklist = (previous.result as OfflineRecord | undefined)?.checklist ?? [];
+          const clear = store.clear();
+          clear.onsuccess = () => store.put({ publicId, report: validated, checklist } satisfies OfflineRecord);
+        };
+      });
+    } finally {
+      db.close();
+    }
+  });
+}
+
+export async function loadCachedReport(publicId: string): Promise<AnalysisReport | null> {
+  const record = await read(publicId);
+  if (!record) return null;
+  const parsed = AnalysisReportSchema.safeParse(record.report);
+  return parsed.success && parsed.data.publicId === publicId ? parsed.data : null;
+}
+
+export async function saveChecklist(publicId: string, checked: string[]): Promise<void> {
+  await orderedMutation(async () => {
+    const db = await database();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        const transaction = db.transaction(STORE, "readwrite");
+        transaction.oncomplete = () => resolve();
+        transaction.onerror = () => reject(transaction.error);
+        transaction.onabort = () => reject(transaction.error);
+        const store = transaction.objectStore(STORE);
+        const current = store.get(publicId);
+        current.onsuccess = () => {
+          const record = current.result as OfflineRecord | undefined;
+          if (record) store.put({ ...record, checklist: [...new Set(checked)] } satisfies OfflineRecord);
+          else transaction.commit();
+        };
+      });
+    } finally {
+      db.close();
+    }
+  });
+}
+
+export async function loadChecklist(publicId: string): Promise<string[]> {
+  const record = await read(publicId);
+  return record?.checklist ?? [];
+}
+
+export async function clearCachedReport(publicId: string): Promise<void> {
+  await orderedMutation(async () => {
+    const db = await database();
+    try {
+      await new Promise<void>((resolve, reject) => {
+        const transaction = db.transaction(STORE, "readwrite");
+        transaction.oncomplete = () => resolve();
+        transaction.onerror = () => reject(transaction.error);
+        transaction.onabort = () => reject(transaction.error);
+        transaction.objectStore(STORE).delete(publicId);
+      });
+    } finally {
+      db.close();
+    }
+  });
+}
diff --git a/src/features/offline/service-worker.ts b/src/features/offline/service-worker.ts
new file mode 100644
index 0000000..a1fb40e
--- /dev/null
+++ b/src/features/offline/service-worker.ts
@@ -0,0 +1,105 @@
+/// <reference lib="webworker" />
+
+const worker = self as unknown as ServiceWorkerGlobalScope;
+const SHELL_CACHE = "kontroll-report-shell-v1";
+const ASSET_CACHE = "kontroll-report-assets-v1";
+const reportPath = /^\/(et|en)\/a\/([0-9a-f-]{36})\/?$/i;
+let pendingCacheWork: Promise<void> = Promise.resolve();
+
+function orderedCacheWork<T>(work: () => Promise<T>): Promise<T> {
+  const result = pendingCacheWork.then(work);
+  pendingCacheWork = result.then(() => undefined, () => undefined);
+  return result;
+}
+
+worker.addEventListener("install", (event) => event.waitUntil(worker.skipWaiting()));
+worker.addEventListener("activate", (event) => event.waitUntil(worker.clients.claim()));
+
+function shellMarker(html: string) {
+  return html.includes('data-report-shell="true"');
+}
+
+async function cacheShell(path: string, observedAssets: string[]): Promise<boolean> {
+  const response = await fetch(path, {
+    credentials: "include",
+    cache: "no-store",
+    headers: { "x-kontroll-offline-shell": "1" },
+  });
+  if (!response.ok || !response.headers.get("content-type")?.includes("text/html")) return false;
+  const html = await response.clone().text();
+  if (!shellMarker(html)) return false;
+  const cache = await caches.open(SHELL_CACHE);
+  const existing = await cache.keys();
+  await Promise.all(existing.map((key) => cache.delete(key)));
+  await cache.put(path, response);
+
+  const assets = [...html.matchAll(/(?:src|href)="(\/_next\/static\/[^"?]+)(?:\?[^"]*)?"/g)]
+    .map((match) => match[1])
+    .filter((value): value is string => Boolean(value));
+  assets.push(...observedAssets.filter((asset) => asset.startsWith("/_next/static/") && !asset.includes("?")));
+  const assetCache = await caches.open(ASSET_CACHE);
+  await Promise.all([...new Set(assets)].map(async (asset) => {
+    try {
+      const loaded = await fetch(asset);
+      if (loaded.ok) await assetCache.put(asset, loaded);
+    } catch {
+      // An asset can still be requested while online; no error is cached.
+    }
+  }));
+  return true;
+}
+
+worker.addEventListener("message", (event) => {
+  const data = event.data as { type?: string; path?: string; assets?: string[] } | null;
+  if (!data || typeof data.path !== "string" || !reportPath.test(data.path)) return;
+  if (data.type === "CACHE_REPORT_SHELL") {
+    event.waitUntil(orderedCacheWork(() => cacheShell(data.path!, Array.isArray(data.assets) ? data.assets : [])).then((cached) => {
+      event.ports[0]?.postMessage(cached);
+    }).catch(() => event.ports[0]?.postMessage(false)));
+  } else if (data.type === "CLEAR_REPORT_SHELL") {
+    event.waitUntil(orderedCacheWork(() => Promise.all([caches.delete(SHELL_CACHE), caches.delete(ASSET_CACHE)])).then(() => {
+      event.ports[0]?.postMessage(true);
+    }));
+  }
+});
+
+function noCopyDocument(locale: string): Response {
+  const et = locale === "et";
+  const title = et ? "Selle raporti kohalikku koopiat pole" : "No local copy of this report is available";
+  const detail = et ? "Ühenda internetiga ja ava privaatne raport uuesti." : "Connect to the internet and open the private report again.";
+  return new Response(`<!doctype html><html lang="${et ? "et" : "en"}"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${title}</title><body style="margin:0;background:#141d29;color:#edf1f5;font:16px Arial,sans-serif"><main style="max-width:45rem;padding:3rem 1rem"><h1>${title}</h1><p style="color:#abb9c9;line-height:1.6">${detail}</p></main></body></html>`, {
+    headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store" },
+  });
+}
+
+worker.addEventListener("fetch", (event) => {
+  const url = new URL(event.request.url);
+  if (url.origin !== worker.location.origin || event.request.method !== "GET") return;
+  const report = reportPath.exec(url.pathname);
+  if (event.request.mode === "navigate" && report && !url.search) {
+    event.respondWith((async () => {
+      try {
+        return await fetch(event.request);
+      } catch {
+        return (await caches.keys()).includes(SHELL_CACHE)
+          ? await (await caches.open(SHELL_CACHE)).match(url.pathname) ?? noCopyDocument(report[1] ?? "en")
+          : noCopyDocument(report[1] ?? "en");
+      }
+    })());
+    return;
+  }
+  if (!url.pathname.startsWith("/_next/static/") || url.search) return;
+  event.respondWith(orderedCacheWork(async () => {
+    const hasAuthorizedShell = (await caches.keys()).includes(SHELL_CACHE)
+      && (await (await caches.open(SHELL_CACHE)).keys()).length > 0;
+    try {
+      const response = await fetch(event.request);
+      if (hasAuthorizedShell && response.ok) await (await caches.open(ASSET_CACHE)).put(event.request, response.clone());
+      return response;
+    } catch {
+      return hasAuthorizedShell
+        ? await (await caches.open(ASSET_CACHE)).match(event.request) ?? Response.error()
+        : Response.error();
+    }
+  }));
+});
