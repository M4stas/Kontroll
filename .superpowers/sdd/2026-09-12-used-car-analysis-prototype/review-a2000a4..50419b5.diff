diff --git a/tests/unit/offline/report-cache.test.ts b/tests/unit/offline/report-cache.test.ts
new file mode 100644
index 0000000..17362a1
--- /dev/null
+++ b/tests/unit/offline/report-cache.test.ts
@@ -0,0 +1,126 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { cacheReport, clearCachedReport, loadCachedReport, loadChecklist, saveChecklist } from "@/features/offline/report-cache";
+import { sampleReport } from "../../fixtures/sample-report";
+
+// Small IndexedDB stand-in; the browser journey covers the native implementation.
+function installDatabase(onGet?: () => Promise<void>) {
+  const rows = new Map<string, unknown>();
+  const request = (result?: unknown) => {
+    const entry = { result, onsuccess: null as null | (() => void), onerror: null as null | (() => void) };
+    queueMicrotask(() => entry.onsuccess?.());
+    return entry;
+  };
+  const store = {
+    get: (id: string) => {
+      const entry = { result: rows.get(id), onsuccess: null as null | (() => void), onerror: null as null | (() => void) };
+      void (onGet?.() ?? Promise.resolve()).then(() => queueMicrotask(() => entry.onsuccess?.()));
+      return entry;
+    },
+    put: (value: { publicId: string }) => { rows.set(value.publicId, value); return request(); },
+    clear: () => { rows.clear(); return request(); },
+    delete: (id: string) => { rows.delete(id); return request(); },
+  };
+  const database = {
+    close: () => undefined,
+    objectStoreNames: { contains: () => true },
+    createObjectStore: () => store,
+    transaction: () => {
+      const transaction = {
+        oncomplete: null as null | (() => void),
+        onerror: null as null | (() => void),
+        onabort: null as null | (() => void),
+        error: null,
+        commit: () => queueMicrotask(() => transaction.oncomplete?.()),
+        objectStore: () => ({
+          ...store,
+          put: (value: { publicId: string }) => {
+            const result = store.put(value);
+            queueMicrotask(() => transaction.oncomplete?.());
+            return result;
+          },
+          delete: (id: string) => {
+            const result = store.delete(id);
+            queueMicrotask(() => transaction.oncomplete?.());
+            return result;
+          },
+        }),
+      };
+      return transaction;
+    },
+  };
+  vi.stubGlobal("indexedDB", {
+    open: () => {
+      const entry = { result: database, onupgradeneeded: null as null | (() => void), onsuccess: null as null | (() => void), onerror: null as null | (() => void) };
+      queueMicrotask(() => { entry.onupgradeneeded?.(); entry.onsuccess?.(); });
+      return entry;
+    },
+  });
+  return rows;
+}
+
+afterEach(() => vi.unstubAllGlobals());
+
+describe("offline report cache", () => {
+  it("keeps the latest validated report under its public ID", async () => {
+    installDatabase();
+    await cacheReport(sampleReport.publicId, sampleReport);
+    expect(await loadCachedReport("other-analysis")).toBeNull();
+    expect((await loadCachedReport(sampleReport.publicId))?.verdict).toBe("worth_viewing");
+    await clearCachedReport(sampleReport.publicId);
+    expect(await loadCachedReport(sampleReport.publicId)).toBeNull();
+  });
+
+  it("rejects malformed or mismatched data and never persists an access token", async () => {
+    const rows = installDatabase();
+    await expect(cacheReport("other-analysis", sampleReport)).rejects.toThrow();
+    await expect(cacheReport(sampleReport.publicId, { ...sampleReport, verdict: "unsafe" } as never)).rejects.toThrow();
+    await expect(cacheReport(sampleReport.publicId, { ...sampleReport, accessToken: "secret" } as never)).rejects.toThrow();
+    expect(JSON.stringify([...rows.values()])).not.toContain("secret");
+  });
+
+  it("retains checklist marks for the current report and clears them with it", async () => {
+    installDatabase();
+    await cacheReport(sampleReport.publicId, sampleReport);
+    await saveChecklist(sampleReport.publicId, ["inspect-cold-start"]);
+    await cacheReport(sampleReport.publicId, { ...sampleReport, updatedAt: "2026-09-21T08:05:00.000Z" });
+    expect(await loadChecklist(sampleReport.publicId)).toEqual(["inspect-cold-start"]);
+    await clearCachedReport(sampleReport.publicId);
+    expect(await loadChecklist(sampleReport.publicId)).toEqual([]);
+  });
+
+  it("replaces an older analysis when another report becomes the latest", async () => {
+    installDatabase();
+    await cacheReport(sampleReport.publicId, sampleReport);
+    const nextId = "1c5fa159-2156-47a1-8f5f-e4d94c26db02";
+    await cacheReport(nextId, { ...sampleReport, publicId: nextId });
+    expect(await loadCachedReport(sampleReport.publicId)).toBeNull();
+    expect((await loadCachedReport(nextId))?.publicId).toBe(nextId);
+    await clearCachedReport(sampleReport.publicId);
+    expect((await loadCachedReport(nextId))?.publicId).toBe(nextId);
+  });
+
+  it("does not resurrect a report when checklist persistence overlaps clear", async () => {
+    let pause = false;
+    let releaseRead!: () => void;
+    let readStarted!: () => void;
+    const readGate = new Promise<void>((resolve) => { releaseRead = resolve; });
+    const started = new Promise<void>((resolve) => { readStarted = resolve; });
+    installDatabase(async () => {
+      if (pause) {
+        readStarted();
+        await readGate;
+      }
+    });
+    await cacheReport(sampleReport.publicId, sampleReport);
+    pause = true;
+    const saving = saveChecklist(sampleReport.publicId, ["inspect-cold-start"]);
+    await started;
+    const clearing = clearCachedReport(sampleReport.publicId);
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    pause = false;
+    releaseRead();
+    await Promise.all([saving, clearing]);
+    expect(await loadCachedReport(sampleReport.publicId)).toBeNull();
+    expect(await loadChecklist(sampleReport.publicId)).toEqual([]);
+  });
+});
diff --git a/tests/unit/offline/service-worker.test.ts b/tests/unit/offline/service-worker.test.ts
new file mode 100644
index 0000000..c3e127c
--- /dev/null
+++ b/tests/unit/offline/service-worker.test.ts
@@ -0,0 +1,105 @@
+import { readFileSync } from "node:fs";
+import vm from "node:vm";
+import ts from "typescript";
+import { describe, expect, it } from "vitest";
+
+const path = "/en/a/7c5ad3db-7fdb-469e-a96c-d10bc2dd5fb1";
+const source = readFileSync("src/features/offline/service-worker.ts", "utf8");
+const compiled = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022 } }).outputText;
+
+function response(body: string, contentType = "text/html") {
+  return {
+    ok: true,
+    headers: { get: (name: string) => name === "content-type" ? contentType : null },
+    text: async () => body,
+    clone() { return response(body, contentType); },
+  };
+}
+
+function harness(fetcher: (input: string | { url: string }) => Promise<ReturnType<typeof response>>) {
+  const listeners = new Map<string, (event: never) => void>();
+  const stores = new Map<string, Map<string, ReturnType<typeof response>>>();
+  const cache = (name: string) => {
+    let entries = stores.get(name);
+    if (!entries) { entries = new Map(); stores.set(name, entries); }
+    return {
+      keys: async () => [...entries.keys()],
+      delete: async (key: string) => entries!.delete(key),
+      put: async (key: string | { url: string }, value: ReturnType<typeof response>) => { entries!.set(typeof key === "string" ? key : key.url, value); },
+      match: async (key: string | { url: string }) => entries!.get(typeof key === "string" ? key : key.url),
+    };
+  };
+  const caches = { open: async (name: string) => cache(name), delete: async (name: string) => stores.delete(name), keys: async () => [...stores.keys()] };
+  vm.runInNewContext(compiled, {
+    self: { location: { origin: "https://example.test" }, addEventListener: (type: string, handler: (event: never) => void) => listeners.set(type, handler) },
+    caches, fetch: fetcher, URL, Promise, Set, Response: { error: () => ({ ok: false }) },
+  });
+  const message = (type: string) => {
+    let work = Promise.resolve();
+    listeners.get("message")?.({
+      data: { type, path },
+      ports: [{ postMessage: () => undefined }],
+      waitUntil: (promise: Promise<void>) => { work = promise; },
+    } as never);
+    return work;
+  };
+  const staticFetch = (url: string) => {
+    let work = Promise.resolve();
+    listeners.get("fetch")?.({
+      request: { url, method: "GET" },
+      respondWith: (promise: Promise<void>) => { work = promise; },
+    } as never);
+    return work;
+  };
+  return { message, staticFetch, cache, stores };
+}
+
+describe("service worker clear ordering", () => {
+  it("does not restore a shell whose fetch was in flight when clear began", async () => {
+    let release!: () => void;
+    let entered!: () => void;
+    const gate = new Promise<void>((resolve) => { release = resolve; });
+    const started = new Promise<void>((resolve) => { entered = resolve; });
+    const worker = harness(async () => {
+      entered();
+      await gate;
+      return response('<main data-report-shell="true"></main>');
+    });
+    const saving = worker.message("CACHE_REPORT_SHELL");
+    await started;
+    const clearing = worker.message("CLEAR_REPORT_SHELL");
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    release();
+    await Promise.all([saving, clearing]);
+    expect(worker.stores.has("kontroll-report-shell-v1")).toBe(false);
+  });
+
+  it("does not restore a static asset whose fetch was in flight when clear began", async () => {
+    let release!: () => void;
+    let entered!: () => void;
+    const gate = new Promise<void>((resolve) => { release = resolve; });
+    const started = new Promise<void>((resolve) => { entered = resolve; });
+    const worker = harness(async () => {
+      entered();
+      await gate;
+      return response("asset", "text/javascript");
+    });
+    await worker.cache("kontroll-report-shell-v1").put(path, response("shell"));
+    const fetching = worker.staticFetch("https://example.test/_next/static/chunks/report.js");
+    await started;
+    const clearing = worker.message("CLEAR_REPORT_SHELL");
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    release();
+    await Promise.all([fetching, clearing]);
+    expect(worker.stores.has("kontroll-report-assets-v1")).toBe(false);
+  });
+
+  it("keeps Cache Storage removed when a static asset is requested after clear", async () => {
+    const worker = harness(async () => response("asset", "text/javascript"));
+    await worker.cache("kontroll-report-shell-v1").put(path, response("shell"));
+    await worker.message("CLEAR_REPORT_SHELL");
+    await worker.staticFetch("https://example.test/_next/static/chunks/report.js");
+    expect(worker.stores.has("kontroll-report-shell-v1")).toBe(false);
+    expect(worker.stores.has("kontroll-report-assets-v1")).toBe(false);
+  });
+});
