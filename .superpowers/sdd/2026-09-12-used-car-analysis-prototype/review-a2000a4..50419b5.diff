+  --sidebar: var(--ink-navy);
+  --sidebar-foreground: var(--off-white);
+  --sidebar-primary: var(--pale-blue);
+  --sidebar-primary-foreground: var(--ink-navy);
+  --sidebar-accent: var(--amber);
