+    const pipeline = await createWorkerPipeline({ workerNow: new Date() });
+    for (let index = 0; index < 5; index += 1) await pipeline.processNext();
+    for (let attempt = 1; attempt <= 4; attempt += 1) {
+      const job = await jobs.leaseForAnalysis("exhausted-enrich-worker", 60, pipeline.initial.id);
+      expect(job?.stage).toBe("enrich");
+      if (!job) throw new Error("Missing enrich job");
+      await processJob(job, {
+        workerId: "exhausted-enrich-worker", jobs,
+        stages: { ...pipeline.stages, enrich: async () => { throw Object.assign(new Error("enrichment offline"), { transient: true }); } },
+      });
+      expect((await client.from("analysis_jobs").update({ available_at: new Date(Date.now() - 1000).toISOString() })
+        .eq("id", job.id)).error).toBeNull();
+    }
+    const { data: failedRun } = await client.from("analysis_runs").select("stage_states")
+      .eq("id", pipeline.initial.current_run_id).single();
+    expect(failedRun?.stage_states?.enrich).toMatchObject({ status: "unavailable" });
+    expect((await pipeline.processNext()).stage).toBe("assemble_report");
+    await expect(analyses.loadReport(pipeline.publicId)).resolves.toMatchObject({ status: "complete" });
+  });
+
+  it("does not display committed artifacts whose producer did not publish terminal state", async () => {
+    const pipeline = await createWorkerPipeline();
+    const { id: analysisId, current_run_id: runId } = pipeline.initial;
+    const source = await client.from("source_snapshots").insert({
+      analysis_id: analysisId, run_id: runId, source_type: "auto24",
+      extraction_status: "complete", producer_stage: "capture_listing",
+    }).select("id").single();
+    expect(source.error).toBeNull();
+    const fact = await client.from("vehicle_facts").insert({
+      analysis_id: analysisId, run_id: runId, source_snapshot_id: source.data!.id,
+      fact_key: "vin", fact_value: "UNPUBLISHED", verification: "unverified",
+      match_confidence: 0.9, producer_stage: "normalize_identity",
+    });
+    expect(fact.error).toBeNull();
+    const evidence = await client.from("evidence").insert({
+      analysis_id: analysisId, run_id: runId, source_snapshot_id: source.data!.id,
+      source_class: "seller", claim: "Unpublished claim", applicability: "exact vehicle",
+      confidence: 0.8, producer_stage: "baseline_checks",
+    });
+    expect(evidence.error).toBeNull();
+    const report = await analyses.loadReport(pipeline.publicId);
+    expect(report?.vehicleFacts).toEqual([]);
+    expect(report?.evidence).toEqual([]);
+    expect(report?.sources).toEqual({});
+  });
+
+  it("leases older work before a newer initial partial assembly", async () => {
+    const older = await createWorkerPipeline();
+    const newer = await createWorkerPipeline();
+    const done = { version: 1, status: "complete", output: {}, warnings: [], completedAt: capturedAt };
+    for (const pipeline of [older, newer]) {
+      const runId = pipeline.initial.current_run_id;
+      const { error } = await client.from("analysis_runs").update({
+        stage_states: { capture_listing: done, normalize_identity: done, baseline_checks: done },
+      }).eq("id", runId);
+      expect(error).toBeNull();
+      expect((await client.from("analysis_jobs").update({ status: "complete" })
+        .eq("run_id", runId).eq("stage", "capture_listing")).error).toBeNull();
+    }
+    await jobs.enqueue({ analysisId: older.initial.id, runId: older.initial.current_run_id, stage: "research" });
+    await jobs.enqueue({ analysisId: newer.initial.id, runId: newer.initial.current_run_id, stage: "assemble_report" });
+    // Keep the older fixture ahead of jobs that another local process may enqueue after the guard.
+    expect((await client.from("analysis_runs").update({ created_at: "0001-01-01T00:00:00+00:00" })
+      .eq("id", older.initial.current_run_id)).error).toBeNull();
+    await expectNoForeignQueuedJobs([older.initial.id, newer.initial.id]);
+    const first = await jobs.lease("fairness-worker", 60);
+    expect(first?.analysisId).toBe(older.initial.id);
+    expect(first?.stage).toBe("research");
+  });
+});
diff --git a/tests/integration/research-cache.test.ts b/tests/integration/research-cache.test.ts
new file mode 100644
index 0000000..5df0e9f
--- /dev/null
+++ b/tests/integration/research-cache.test.ts
@@ -0,0 +1,188 @@
+import { execFileSync } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import { createClient, type SupabaseClient } from "@supabase/supabase-js";
+import { afterEach, beforeAll, beforeEach, describe, expect, it } from "vitest";
+import type { NormalizedVehicle } from "@/analysis/normalize";
+import { buildResearchKey, cacheExpiryAt } from "@/research/cache-key";
+import { CachedResearchProvider, type ResearchProvider, type VehicleResearch } from "@/research/provider";
+import { ResearchRepository } from "@/server/repositories/research";
+
+function localServiceClient(): SupabaseClient {
+  const output = execFileSync("npx", ["supabase", "status", "-o", "env"], { encoding: "utf8" });
+  const values = Object.fromEntries(output.trim().split("\n").map((line) => {
+    const separator = line.indexOf("=");
+    return [line.slice(0, separator), JSON.parse(line.slice(separator + 1)) as string];
+  }));
+  const key = values.SERVICE_ROLE_KEY ?? values.SECRET_KEY;
+  if (!values.API_URL || !key) throw new Error("Local Supabase service credentials are unavailable");
+  return createClient(values.API_URL, key, { auth: { autoRefreshToken: false, persistSession: false } });
+}
+
+let fixtureToken = "";
+function vehicle(engineVariant = "2.0 TDI 140 kW"): NormalizedVehicle {
+  return {
+    make: "Volkswagen",
+    model: "Passat",
+    year: 2017,
+    mileageKm: 332000,
+    generation: "B8",
+    engineVariant: `${engineVariant} ${fixtureToken}`,
+    gearboxVariant: "DSG DQ250",
+    provenance: {} as NormalizedVehicle["provenance"],
+    conflicts: [],
+  };
+}
+
+function research(summary: string): VehicleResearch {
+  return {
+    summary,
+    sourceRefs: [{
+      url: "https://example.test/technical-bulletin",
+      sourceClass: "independent",
+      retrievedAt: "2026-09-14T00:00:00.000Z",
+      applicability: "exact",
+    }],
+  };
+}
+
+describe("ResearchRepository-backed cache", () => {
+  const now = new Date("2026-09-14T00:00:00.000Z");
+  let client: SupabaseClient;
+  let repository: ResearchRepository;
+
+  beforeAll(() => {
+    client = localServiceClient();
+    repository = new ResearchRepository(client);
+  });
+
+  beforeEach(async () => {
+    fixtureToken = randomUUID();
+  });
+
+  afterEach(async () => {
+    for (const engine of ["2.0 TDI 140 kW", "2.0 TDI 110 kW"]) {
+      for (const kind of ["recall", "common_issue"] as const) {
+        const key = buildResearchKey(vehicle(engine), kind);
+        if (!key) continue;
+        const { error } = await client.from("vehicle_research_cache").delete().eq("cache_key", key.cacheKey);
+        expect(error).toBeNull();
+      }
+    }
+  });
+
+  // Catches calling the provider even when a fresh cache row exactly identifies this vehicle and claim kind.
+  it("returns a fresh exact row before provider invocation", async () => {
+    const key = buildResearchKey(vehicle(), "recall")!;
+    await repository.put({
+      ...key,
+      result: research("cached recall"),
+      sourceRefs: research("cached recall").sourceRefs,
+      schemaVersion: 1,
+      fetchedAt: now.toISOString(),
+      expiresAt: cacheExpiryAt("recall", now).toISOString(),
+    });
+    let calls = 0;
+    const upstream: ResearchProvider = { research: async () => { calls += 1; return research("live recall"); } };
+
+    const cached: ResearchProvider = new CachedResearchProvider(repository, upstream, "recall", () => now);
+    const result = await cached.research(vehicle());
+
+    expect(result).toEqual(research("cached recall"));
+    expect(calls).toBe(0);
+  });
+
+  // Catches an incompatible cached result shape being returned as a current-schema exact match.
+  it("refreshes a fresh row from a different research schema", async () => {
+    const key = buildResearchKey(vehicle(), "common_issue")!;
+    await repository.put({
+      ...key,
+      result: research("legacy result"),
+      sourceRefs: research("legacy result").sourceRefs,
+      schemaVersion: 2,
+      fetchedAt: now.toISOString(),
+      expiresAt: cacheExpiryAt("common_issue", now).toISOString(),
+    });
+    let calls = 0;
+    const upstream: ResearchProvider = { research: async () => {
+      calls += 1;
+      return research("current result");
+    } };
+
+    await expect(new CachedResearchProvider(repository, upstream, "common_issue", () => now).research(vehicle()))
+      .resolves.toEqual(research("current result"));
+
+    expect(calls).toBe(1);
+  });
+
+  // Catches the cache decorator widening the provider's required one-argument contract.
+  it("invokes a cache-miss provider with only the normalized vehicle", async () => {
+    const calls: unknown[][] = [];
+    const upstream: ResearchProvider = { research: async (...args) => {
+      calls.push(args);
+      return research("fresh result");
+    } };
+
+    await new CachedResearchProvider(repository, upstream, "common_issue", () => now).research(vehicle());
+
+    expect(calls).toEqual([[vehicle()]]);
+  });
+
+  // Catches an unresolved cache identity leaking a null result through the provider contract.
+  it("returns upstream research without caching when identity is unresolved", async () => {
+    let calls = 0;
+    const upstream: ResearchProvider = { research: async () => {
+      calls += 1;
+      return research("uncached result");
+    } };
+    const cached: ResearchProvider = new CachedResearchProvider(repository, upstream, "common_issue", () => now);
+
+    await expect(cached.research({ ...vehicle(), make: undefined })).resolves.toEqual(research("uncached result"));
+    expect(calls).toBe(1);
+  });
+
+  // Catches expired rows suppressing fresh provider work or dropping stored source provenance on replacement.
+  it("replaces an expired row with normalized result and source provenance", async () => {
+    const key = buildResearchKey(vehicle(), "common_issue")!;
+    await repository.put({
+      ...key,
+      result: research("expired"),
+      sourceRefs: research("expired").sourceRefs,
+      schemaVersion: 1,
+      fetchedAt: "2026-06-01T00:00:00.000Z",
+      expiresAt: "2026-08-30T00:00:00.000Z",
+    });
+    const upstream: ResearchProvider = { research: async () => research("fresh issue summary") };
+
+    await expect(new CachedResearchProvider(repository, upstream, "common_issue", () => now).research(vehicle()))
+      .resolves.toEqual(research("fresh issue summary"));
+
+    const { data, error } = await client.from("vehicle_research_cache")
+      .select("result, source_refs, schema_version, fetched_at, expires_at")
+      .eq("cache_key", key.cacheKey)
+      .single();
+    expect(error).toBeNull();
+    expect(data).toEqual({
+      result: research("fresh issue summary"),
+      source_refs: research("fresh issue summary").sourceRefs,
+      schema_version: 1,
+      fetched_at: "2026-09-14T00:00:00+00:00",
+      expires_at: "2026-12-13T00:00:00+00:00",
+    });
+  });
+
+  // Catches an engine-specific result being reused for a different engine despite shared make, model, and year.
+  it("isolates cache entries for distinct exact engine variants", async () => {
+    let calls = 0;
+    const upstream: ResearchProvider = { research: async (requested) => {
+      calls += 1;
+      return research(`research for ${requested.engineVariant}`);
+    } };
+    const cached: ResearchProvider = new CachedResearchProvider(repository, upstream, "common_issue", () => now);
+
+    await cached.research(vehicle("2.0 TDI 140 kW"));
+    await expect(cached.research(vehicle("2.0 TDI 110 kW")))
+      .resolves.toEqual(research(`research for 2.0 TDI 110 kW ${fixtureToken}`));
+
+    expect(calls).toBe(2);
+  });
+});
