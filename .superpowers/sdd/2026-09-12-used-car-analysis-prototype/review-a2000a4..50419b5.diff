new file mode 100644
index 0000000..8093411
--- /dev/null
+++ b/src/analysis/assemble-report.ts
@@ -0,0 +1,83 @@
+import { calculateConfidence } from "@/domain/confidence";
+import { AnalysisReportSchema } from "@/domain/schemas";
+import { calculateVerdict } from "@/domain/verdict";
+import type {
+  Action,
+  AnalysisReport,
+  AnalysisStatus,
+  ConfidenceInput,
+  Evidence,
+  Finding,
+  Locale,
+  SourceSummary,
+  VehicleFact,
+} from "@/domain/analysis";
+
+type SourceState = SourceSummary["verification"] | "unavailable" | SourceSummary;
+
+export interface AssemblyInput {
+  publicId: string;
+  locale: Locale;
+  status: AnalysisStatus;
+  vehicleFacts?: VehicleFact[];
+  evidence: Evidence[];
+  findings: Finding[];
+  actions?: Action[];
+  sourceStates?: Record<string, SourceState>;
+  warnings?: string[];
+  confidenceInput?: ConfidenceInput;
+  updatedAt: string;
+}
+
+function normalizedIntent(action: Action): string {
+  return [action.kind, action.title, action.instructions]
+    .map((value) => value.replace(/\s+/g, " ").trim().toLocaleLowerCase("en"))
+    .join("\n");
+}
+
+function sourceSummary(state: SourceState): SourceSummary {
+  if (state === "unavailable") return { verification: "not_checked" };
+  if (typeof state === "string") return { verification: state };
+  return { ...state, verification: state.verification === "not_checked" ? "not_checked" : state.verification };
+}
+
+export function assembleReport(input: AssemblyInput): AnalysisReport {
+  const evidenceIds = new Set(input.evidence.map((item) => item.id));
+  const warnings = [...new Set(input.warnings ?? [])];
+  const findings = input.findings.filter((finding) => {
+    if (finding.severity === "context") return true;
+    const supported = finding.evidenceIds.length > 0
+      && finding.evidenceIds.every((evidenceId) => evidenceIds.has(evidenceId));
+    if (!supported && !warnings.includes("finding_without_evidence")) {
+      warnings.push("finding_without_evidence");
+    }
+    return supported;
+  });
+  const findingIds = new Set(findings.map((finding) => finding.id));
+  const seenActions = new Set<string>();
+  const actions = (input.actions ?? []).filter((action) => {
+    if (action.findingId && !findingIds.has(action.findingId)) return false;
+    const key = `${action.findingId ?? ""}\n${normalizedIntent(action)}`;
+    if (seenActions.has(key)) return false;
+    seenActions.add(key);
+    return true;
+  });
+  const confidence = input.confidenceInput ? calculateConfidence(input.confidenceInput) : null;
+  const report: AnalysisReport = {
+    publicId: input.publicId,
+    status: input.status,
+    locale: input.locale,
+    verdict: confidence ? calculateVerdict(findings, confidence) : null,
+    confidence,
+    vehicleFacts: input.vehicleFacts ?? [],
+    evidence: input.evidence,
+    findings,
+    actions,
+    sources: Object.fromEntries(
+      Object.entries(input.sourceStates ?? {}).map(([key, state]) => [key, sourceSummary(state)]),
+    ),
+    warnings,
+    updatedAt: input.updatedAt,
+  };
+  return AnalysisReportSchema.parse(report);
+}
diff --git a/src/analysis/baseline-checks.ts b/src/analysis/baseline-checks.ts
new file mode 100644
index 0000000..4183488
--- /dev/null
+++ b/src/analysis/baseline-checks.ts
@@ -0,0 +1,322 @@
+import { createHash } from "node:crypto";
+import type { Action, Evidence, Finding, SourceClass } from "@/domain/analysis";
+import type { ListingClaim, ListingSnapshot } from "@/listings/adapter";
+import type { NormalizedVehicle, NormalizedFieldValue } from "@/analysis/normalize";
+
+export interface BaselineResult {
+  evidence: Evidence[];
+  findings: Finding[];
+  actions: Action[];
+}
+
+type RuleName =
+  | "unsupported-major-maintenance"
+  | "missing-gearbox-service-detail"
+  | "listing-mileage-disagreement"
+  | "missing-official-check-identity"
+  | "missing-inspection-images"
+  | "no-investment-without-maintenance-evidence";
+
+function deterministicId(snapshot: ListingSnapshot, entity: string, rule: RuleName, detail = ""): string {
+  const hash = createHash("sha256")
+    .update(
+      `${snapshot.marketplace}\n${snapshot.sourceId}\n${snapshot.sourceUrl}\n${snapshot.contentHash}\n${entity}\n${rule}\n${detail}`,
+    )
+    .digest("hex");
+  const variant = ((Number.parseInt(hash[16] ?? "0", 16) & 0x3) | 0x8).toString(16);
+  return `${hash.slice(0, 8)}-${hash.slice(8, 12)}-5${hash.slice(13, 16)}-${variant}${hash.slice(17, 20)}-${hash.slice(20, 32)}`;
+}
+
+function evidenceForClaim(
+  snapshot: ListingSnapshot,
+  rule: RuleName,
+  claim: string,
+  sourceClass: SourceClass,
+): Evidence {
+  return {
+    id: deterministicId(snapshot, "evidence", rule, claim),
+    sourceId: snapshot.sourceId,
+    sourceClass,
+    sourceUrl: snapshot.sourceUrl,
+    claim,
+    applicability: "Listing or seller statement requiring independent verification.",
+    confidence: 0.5,
+    verification: "unverified",
+    capturedAt: snapshot.capturedAt,
+  };
+}
+
+function evidenceForAbsence(snapshot: ListingSnapshot, rule: RuleName, claim: string): Evidence {
+  return {
+    id: deterministicId(snapshot, "evidence", rule, claim),
+    sourceId: snapshot.sourceId,
+    sourceClass: "listing",
+    sourceUrl: snapshot.sourceUrl,
+    claim,
+    applicability: "Deterministic observation of what the listing snapshot does not provide.",
+    confidence: 0.5,
+    verification: "unverified",
+    capturedAt: snapshot.capturedAt,
+  };
+}
+
+function evidenceForMileage(
+  snapshot: ListingSnapshot,
+  rule: RuleName,
+  value: NormalizedFieldValue,
+): Evidence {
+  return {
+    id: deterministicId(snapshot, "evidence", rule, `${value.value}:${value.sourceIds.join(",")}`),
+    sourceId: value.sourceIds[0] ?? snapshot.sourceId,
+    sourceClass: "listing",
+    sourceUrl: snapshot.sourceUrl,
+    claim: `Listing mileage fact: ${value.value} km.`,
+    applicability: "Conflicting odometer values require independent verification.",
+    confidence: 0.5,
+    verification: "contradicted",
+    capturedAt: snapshot.capturedAt,
+  };
+}
+
+function evidenceForIdentityConflict(
+  snapshot: ListingSnapshot,
+  field: "vin" | "registrationPlate",
+  value: NormalizedFieldValue,
+): Evidence {
+  const label = field === "vin" ? "VIN" : "registration plate";
+  return {
+    id: deterministicId(
+      snapshot,
+      "evidence",
+      "missing-official-check-identity",
+      `${field}:${value.value}:${value.sourceIds.join(",")}`,
+    ),
+    sourceId: value.sourceIds[0] ?? snapshot.sourceId,
+    sourceClass: "listing",
+    sourceUrl: snapshot.sourceUrl,
+    claim: `Conflicting ${label} fact: ${value.value}.`,
+    applicability: "Conflicting listing identity values must be resolved before official checks.",
+    confidence: 0.5,
+    verification: "contradicted",
+    capturedAt: snapshot.capturedAt,
+  };
+}
+
+function evidenceForImageCoverage(snapshot: ListingSnapshot, referenceCount: number): Evidence {
+  const claim = referenceCount === 0
+    ? "Listing snapshot provides no image references; required inspection coverage is unverified."
+    : `Listing snapshot includes ${referenceCount} image references, but their required inspection categories are unclassified.`;
+  return {
+    id: deterministicId(snapshot, "evidence", "missing-inspection-images", claim),
+    sourceId: snapshot.sourceId,
+    sourceClass: "listing",
+    sourceUrl: snapshot.sourceUrl,
+    claim,
+    applicability: "Image references do not establish a requested inspection category without classification.",
+    confidence: 0.5,
+    verification: "unverified",
+    capturedAt: snapshot.capturedAt,
+  };
+}
+
+function addFinding(
+  result: BaselineResult,
+  snapshot: ListingSnapshot,
+  rule: RuleName,
+  category: string,
+  title: string,
+  explanation: string,
+  nextAction: string,
+  evidence: Evidence[],
+  action: Pick<Action, "kind" | "title" | "instructions">,
+): void {
+  const findingId = deterministicId(snapshot, "finding", rule);
+  result.evidence.push(...evidence);
+  result.findings.push({
+    id: findingId,
+    category,
+    severity: "important",
+    state: "open",
+    title,
+    explanation,
+    nextAction,
+    evidenceIds: evidence.map((item) => item.id),
+    origin: "deterministic",
+  });
+  result.actions.push({
+    id: deterministicId(snapshot, "action", rule),
+    ...action,
+    status: "open",
+    findingId,
+  });
+}
+
+function firstMatchingClaim(snapshot: ListingSnapshot, pattern: RegExp): ListingClaim | undefined {
+  return snapshot.claims.find((claim) => pattern.test(claim.text));
+}
+
+function listingStatement(
+  snapshot: ListingSnapshot,
+  pattern: RegExp,
+): { text: string; sourceClass: SourceClass } | undefined {
+  const claim = firstMatchingClaim(snapshot, pattern);
+  if (claim) return { text: claim.text, sourceClass: claim.sourceClass };
+  if (pattern.test(snapshot.description)) return { text: snapshot.description, sourceClass: "listing" };
+  return undefined;
+}
+
+function hasGearboxServiceDetail(snapshot: ListingSnapshot): boolean {
+  const text = [snapshot.description, ...snapshot.claims.map((claim) => claim.text)].join(" ").toLocaleLowerCase("et");
+  return /(?:käigukast|gearbox|transmission|dsg).{0,80}(?:hooldus|õli|oil|service|vahet|changed)|(?:hooldus|õli|oil|service|vahet|changed).{0,80}(?:käigukast|gearbox|transmission|dsg)/.test(text);
+}
+
+function hasMaintenanceEvidenceReference(snapshot: ListingSnapshot): boolean {
+  if (snapshot.screenshotRefs.length > 0) return true;
+  return snapshot.imageUrls.some((url) => (
+    /service[-_ ]?(?:book|record|document)|hooldus(?:raamat|dokument)/i.test(url)
+  ));
+}
+
+export function runBaselineChecks(vehicle: NormalizedVehicle, snapshot: ListingSnapshot): BaselineResult {
+  const result: BaselineResult = { evidence: [], findings: [], actions: [] };
+  const majorMaintenance = listingStatement(snapshot, /suur\s+hooldus|major\s+(?:service|maintenance)/i);
+  if (majorMaintenance) {
+    addFinding(
+      result,
+      snapshot,
+      "unsupported-major-maintenance",
+      "unsupported_major_maintenance",
+      "Major maintenance claim needs documentation",
+      "The listing states that major maintenance was completed, but the statement is unverified.",
+      "Request invoices or service records for the claimed work.",
+      [evidenceForClaim(snapshot, "unsupported-major-maintenance", majorMaintenance.text, majorMaintenance.sourceClass)],
+      {
+        kind: "document_request",
+        title: "Request major-service documentation",
+        instructions: "Ask the seller for invoices or service records that identify the completed major maintenance.",
+      },
+    );
+  }
+
+  if (vehicle.transmission === "automatic" && !hasGearboxServiceDetail(snapshot)) {
+    addFinding(
+      result,
+      snapshot,
+      "missing-gearbox-service-detail",
+      "missing_gearbox_service_detail",
+      "Automatic gearbox service detail is missing",
+      "The listing identifies an automatic transmission but provides no gearbox service detail.",
+      "Ask when the gearbox oil and related service were last completed.",
+      [evidenceForAbsence(snapshot, "missing-gearbox-service-detail", "Automatic transmission is listed without gearbox service detail.")],
+      {
+        kind: "seller_question",
+        title: "Ask about gearbox service",
+        instructions: "Ask for the gearbox type, the last service date, mileage, and supporting invoice.",
+      },
+    );
+  }
+
+  const mileageConflict = vehicle.conflicts.find((conflict) => conflict.field === "mileageKm");
+  if (mileageConflict) {
+    addFinding(
+      result,
+      snapshot,
+      "listing-mileage-disagreement",
+      "listing_mileage_disagreement",
+      "Listing mileage values disagree",
+      "Distinct listing facts provide conflicting odometer readings, so the mileage remains unresolved.",
+      "Verify the odometer reading and its history during inspection.",
+      mileageConflict.values.map((value) => evidenceForMileage(snapshot, "listing-mileage-disagreement", value)),
+      {
+        kind: "inspection_task",
+        title: "Verify mileage history",
+        instructions: "Compare the odometer, service records, and official history against the conflicting listing values.",
+      },
+    );
+  }
+
+  if (!vehicle.vin && !vehicle.registrationPlate) {
+    const identityConflicts = vehicle.conflicts.filter((conflict) => (
+      conflict.field === "vin" || conflict.field === "registrationPlate"
+    ));
+    const conflictLabels = identityConflicts.map((conflict) => (
+      conflict.field === "vin" ? "VIN" : "registration plate"
+    ));
+    const identityEvidence = identityConflicts.flatMap((conflict) => (
+      conflict.values.map((value) => evidenceForIdentityConflict(
+        snapshot,
+        conflict.field as "vin" | "registrationPlate",
+        value,
+      ))
+    ));
+    if (identityEvidence.length === 0) {
+      identityEvidence.push(evidenceForAbsence(
+        snapshot,
+        "missing-official-check-identity",
+        "Listing snapshot has no resolved usable VIN or Estonian registration plate for official checks.",
+      ));
+    }
+    const explanation = conflictLabels.length > 0
+      ? `The listing has conflicting ${conflictLabels.join(" and ")} values and no resolved usable VIN or Estonian registration plate for official checks.`
+      : "The listing has no resolved usable VIN or Estonian registration plate for official checks.";
+    addFinding(
+      result,
+      snapshot,
+      "missing-official-check-identity",
+      "missing_official_check_identity",
+      "Official-check identity is missing",
+      explanation,
+      "Request a VIN or registration plate before relying on official history checks.",
+      identityEvidence,
+      {
+        kind: "seller_question",
+        title: "Request VIN or registration plate",
+        instructions: "Ask the seller to provide either the VIN or the registration plate for official checks.",
+      },
+    );
+  }
+
+  const imageReferenceCount = snapshot.imageUrls.length + snapshot.screenshotRefs.length;
+  const imageExplanation = imageReferenceCount === 0
+    ? "The listing snapshot provides no image references, so underside, engine-bay, instrument-cluster, and service-document coverage cannot be verified."
+    : "The listing snapshot contains image references, but they are not classified as underside, engine-bay, instrument-cluster, or service-document evidence.";
+  addFinding(
+    result,
+    snapshot,
+    "missing-inspection-images",
+    "missing_inspection_images",
+    "Inspection image coverage is unverified",
+    imageExplanation,
+    "Request classified underside, engine-bay, instrument-cluster, and service-document photos.",
+    [evidenceForImageCoverage(snapshot, imageReferenceCount)],
+    {
+      kind: "photo_request",
+      title: "Request inspection photos",
+      instructions: "Request clear, labeled underside, engine-bay, instrument-cluster, and service-document photos.",
+    },
+  );
+
+  const noInvestmentStatement = listingStatement(snapshot, /(?:ei\s+vaja\s+lisainvesteeringuid|lisainvesteeringuid\s+ei\s+vaja|no\s+(?:additional\s+)?investment(?:s)?\s+(?:needed|required)?)/i);
+  if (noInvestmentStatement && !hasMaintenanceEvidenceReference(snapshot)) {
+    addFinding(
+      result,
+      snapshot,
+      "no-investment-without-maintenance-evidence",
+      "no_investment_without_maintenance_evidence",
+      "No-investment claim lacks maintenance evidence",
+      "The listing says that no investment is needed, but provides no independently verifiable material maintenance evidence.",
+      "Request maintenance records before relying on the no-investment claim.",
+      [
+        evidenceForClaim(snapshot, "no-investment-without-maintenance-evidence", noInvestmentStatement.text, noInvestmentStatement.sourceClass),
+        evidenceForAbsence(snapshot, "no-investment-without-maintenance-evidence", "Listing snapshot provides no explicit maintenance evidence references."),
+      ],
+      {
+        kind: "document_request",
+        title: "Request maintenance records",
+        instructions: "Ask for recent invoices and service records that support the no-investment claim.",
+      },
+    );
+  }
+
+  return result;
+}
diff --git a/src/analysis/normalize.ts b/src/analysis/normalize.ts
new file mode 100644
index 0000000..f953df7
--- /dev/null
+++ b/src/analysis/normalize.ts
@@ -0,0 +1,229 @@
+import { normalizeWhitespace, type ListingFact, type ListingSnapshot } from "@/listings/adapter";
+
+export type NormalizedVehicleField =
+  | "make"
+  | "model"
+  | "year"
+  | "mileageKm"
+  | "fuel"
+  | "transmission"
+  | "vin"
+  | "registrationPlate"
+  | "generation"
+  | "engineVariant"
+  | "gearboxVariant";
+
+export interface NormalizedFieldValue {
+  value: string | number;
+  sourceIds: string[];
+}
+
+export interface VehicleFieldConflict {
+  field: NormalizedVehicleField;
+  values: NormalizedFieldValue[];
+}
+
+export interface NormalizedVehicle {
+  make?: string;
+  model?: string;
+  year?: number;
+  mileageKm?: number;
+  fuel?: string;
+  transmission?: string;
+  vin?: string;
+  registrationPlate?: string;
+  generation?: string;
+  engineVariant?: string;
+  gearboxVariant?: string;
+  provenance: Record<NormalizedVehicleField, string[]>;
+  conflicts: VehicleFieldConflict[];
+}
+
+const FIELDS: NormalizedVehicleField[] = [
+  "make",
+  "model",
+  "year",
+  "mileageKm",
+  "fuel",
+  "transmission",
+  "vin",
+  "registrationPlate",
+  "generation",
+  "engineVariant",
+  "gearboxVariant",
+];
+
+const FIELD_KEYS: Record<NormalizedVehicleField, readonly string[]> = {
+  make: ["make", "mark", "brand"],
+  model: ["model", "mudel"],
+  year: ["year", "aasta", "production year"],
+  mileageKm: ["mileage", "läbisõit", "odometer"],
+  fuel: ["fuel", "kütus", "fuel type"],
+  transmission: ["gearbox", "transmission", "käigukast"],
+  vin: ["vin", "vehicle identification number"],
+  registrationPlate: [
+    "registration plate",
+    "registration_plate",
+    "registration number",
+    "registration",
+    "plate",
+    "number plate",
+    "registreerimisnumber",
+    "reg number",
+    "reg nr",
+  ],
+  generation: ["generation", "põlvkond"],
+  engineVariant: ["engine", "engine variant", "mootor", "engine code"],
+  gearboxVariant: ["gearbox variant", "transmission variant", "käigukasti variant"],
+};
+
+function normalizedKey(value: string): string {
+  return normalizeWhitespace(value).toLocaleLowerCase("en");
+}
+
+function normalizeYear(value: string): number | undefined {
+  const match = normalizeWhitespace(value).match(/\b(19\d{2}|20\d{2})\b/);
+  return match ? Number(match[1]) : undefined;
+}
+
+function normalizeMileage(value: string): number | undefined {
+  const match = normalizeWhitespace(value).match(/^(\d+(?:[ .]\d{3})*)\s*km$/i);
+  if (!match) return undefined;
+
+  const mileage = Number(match[1]?.replace(/[ .]/g, ""));
+  return Number.isSafeInteger(mileage) && mileage >= 0 ? mileage : undefined;
+}
+
+function normalizeFuel(value: string): string | undefined {
+  const normalized = normalizedKey(value);
+  const values: Record<string, string> = {
+    bensiin: "petrol",
+    petrol: "petrol",
+    gasoline: "petrol",
+    diisel: "diesel",
+    diesel: "diesel",
+    elekter: "electric",
+    electric: "electric",
+    hübriid: "hybrid",
+    hybrid: "hybrid",
+    pistikuhübriid: "plug-in hybrid",
+    "plug-in hybrid": "plug-in hybrid",
+    gaas: "gas",
+    gas: "gas",
+  };
+  return (values[normalized] ?? normalized) || undefined;
+}
+
+function normalizeTransmission(value: string): string | undefined {
+  const normalized = normalizedKey(value);
+  if (/automaat|automatic/.test(normalized)) return "automatic";
+  if (/manuaal|manual/.test(normalized)) return "manual";
+  return normalized || undefined;
+}
+
+function normalizeVin(value: string): string | undefined {
+  const normalized = value.replace(/[\s-]/g, "").toUpperCase();
+  if (!/^[A-HJ-NPR-Z0-9]{17}$/.test(normalized)) return undefined;
+  return new Set(normalized).size > 1 ? normalized : undefined;
+}
+
+function normalizeRegistrationPlate(value: string): string | undefined {
+  const compact = value.replace(/[\s-]/g, "").toUpperCase();
+  const plate = compact.match(/^(\d{3}[A-Z]{3}|\d{2}[A-Z]{2}|\d{3,4}[A-Z]{2})$/);
+  const parts = plate?.[1]?.match(/^(\d+)([A-Z]+)$/);
+  return parts ? `${parts[1]} ${parts[2]}` : undefined;
+}
+
+function normalizeField(field: NormalizedVehicleField, value: string): string | number | undefined {
+  const normalized = normalizeWhitespace(value);
+  if (!normalized) return undefined;
+
+  switch (field) {
+    case "year":
+      return normalizeYear(normalized);
+    case "mileageKm":
+      return normalizeMileage(normalized);
+    case "fuel":
+      return normalizeFuel(normalized);
+    case "transmission":
+      return normalizeTransmission(normalized);
+    case "vin":
+      return normalizeVin(normalized);
+    case "registrationPlate":
+      return normalizeRegistrationPlate(normalized);
+    default:
+      return normalized;
+  }
+}
+
+function factsForField(facts: ListingFact[], field: NormalizedVehicleField): ListingFact[] {
+  const acceptedKeys = FIELD_KEYS[field];
+  return facts.filter((fact) => acceptedKeys.includes(normalizedKey(fact.key)));
+}
+
+function resolveField(
+  facts: ListingFact[],
+  field: NormalizedVehicleField,
+): { value?: string | number; provenance: string[]; conflict?: VehicleFieldConflict } {
+  const values = new Map<string, NormalizedFieldValue>();
+
+  for (const fact of factsForField(facts, field)) {
+    const value = normalizeField(field, fact.value);
+    if (value === undefined) continue;
+
+    const key = `${typeof value}:${value}`;
+    const existing = values.get(key);
+    if (existing) {
+      if (!existing.sourceIds.includes(fact.sourceId)) existing.sourceIds.push(fact.sourceId);
+    } else {
+      values.set(key, { value, sourceIds: [fact.sourceId] });
+    }
+  }
+
+  const resolvedValues = [...values.values()];
+  const provenance = [...new Set(resolvedValues.flatMap((value) => value.sourceIds))];
+  if (resolvedValues.length === 1) return { value: resolvedValues[0]?.value, provenance };
+  if (resolvedValues.length > 1) return { provenance, conflict: { field, values: resolvedValues } };
+  return { provenance };
+}
+
+export function normalizeVehicle(snapshot: ListingSnapshot): NormalizedVehicle {
+  const provenance: Record<NormalizedVehicleField, string[]> = {
+    make: [],
+    model: [],
+    year: [],
+    mileageKm: [],
+    fuel: [],
+    transmission: [],
+    vin: [],
+    registrationPlate: [],
+    generation: [],
+    engineVariant: [],
+    gearboxVariant: [],
+  };
+  const conflicts: VehicleFieldConflict[] = [];
+  const resolved = new Map<NormalizedVehicleField, string | number | undefined>();
+
+  for (const field of FIELDS) {
+    const result = resolveField(snapshot.facts, field);
+    provenance[field] = result.provenance;
+    resolved.set(field, result.value);
+    if (result.conflict) conflicts.push(result.conflict);
+  }
+
+  return {
+    make: resolved.get("make") as string | undefined,
+    model: resolved.get("model") as string | undefined,
+    year: resolved.get("year") as number | undefined,
+    mileageKm: resolved.get("mileageKm") as number | undefined,
+    fuel: resolved.get("fuel") as string | undefined,
+    transmission: resolved.get("transmission") as string | undefined,
+    vin: resolved.get("vin") as string | undefined,
+    registrationPlate: resolved.get("registrationPlate") as string | undefined,
+    generation: resolved.get("generation") as string | undefined,
+    engineVariant: resolved.get("engineVariant") as string | undefined,
+    gearboxVariant: resolved.get("gearboxVariant") as string | undefined,
+    provenance,
+    conflicts,
+  };
+}
