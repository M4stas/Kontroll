+}
diff --git a/src/research/provider.ts b/src/research/provider.ts
new file mode 100644
index 0000000..686ea16
--- /dev/null
+++ b/src/research/provider.ts
@@ -0,0 +1,85 @@
+import type { NormalizedVehicle } from "@/analysis/normalize";
+import {
+  buildResearchKey,
+  cacheExpiryAt,
+  type ResearchClaimKind,
+  type ResearchKey,
+} from "@/research/cache-key";
+import type { EvidenceApplicability } from "@/research/source-policy";
+import {
+  ResearchRepository,
+  type ResearchCacheEntry,
+} from "@/server/repositories/research";
+import type { SourceClass } from "@/domain/analysis";
+
+export const RESEARCH_SCHEMA_VERSION = 1;
+
+export interface ResearchSourceReference {
+  url: string;
+  sourceClass: SourceClass;
+  retrievedAt: string;
+  applicability: EvidenceApplicability;
+}
+
+export interface VehicleResearch {
+  summary: string;
+  sourceRefs: ResearchSourceReference[];
+}
+
+export interface ResearchProvider {
+  research(vehicle: NormalizedVehicle): Promise<VehicleResearch>;
+}
+
+function isExactResearchMatch(
+  entry: ResearchCacheEntry<VehicleResearch, ResearchSourceReference>,
+  key: ResearchKey,
+): boolean {
+  return entry.cacheKey === key.cacheKey
+    && entry.make === key.make
+    && entry.model === key.model
+    && entry.generation === key.generation
+    && entry.engine === key.engine
+    && entry.gearbox === key.gearbox
+    && entry.yearRange === key.yearRange
+    && entry.mileageBand === key.mileageBand
+    && entry.schemaVersion === RESEARCH_SCHEMA_VERSION;
+}
+
+export class CachedResearchProvider implements ResearchProvider {
+  constructor(
+    private readonly repository: ResearchRepository,
+    private readonly upstream: ResearchProvider,
+    private readonly claimKind: ResearchClaimKind = "common_issue",
+    private readonly now: () => Date = () => new Date(),
+  ) {}
+
+  async research(vehicle: NormalizedVehicle): Promise<VehicleResearch> {
+    const key = buildResearchKey(vehicle, this.claimKind);
+    if (!key) return this.upstream.research(vehicle);
+
+    const fetchedAt = this.now();
+    const cached = await this.repository.findFresh<VehicleResearch, ResearchSourceReference>(
+      key.cacheKey,
+      fetchedAt,
+    );
+    if (cached && isExactResearchMatch(cached, key)) return cached.result;
+
+    const result = await this.upstream.research(vehicle);
+    await this.repository.put({
+      cacheKey: key.cacheKey,
+      make: key.make,
+      model: key.model,
+      generation: key.generation,
+      engine: key.engine,
+      gearbox: key.gearbox,
+      yearRange: key.yearRange,
+      mileageBand: key.mileageBand,
+      result,
+      sourceRefs: result.sourceRefs,
+      schemaVersion: RESEARCH_SCHEMA_VERSION,
+      fetchedAt: fetchedAt.toISOString(),
+      expiresAt: cacheExpiryAt(this.claimKind, fetchedAt).toISOString(),
+    });
+    return result;
+  }
+}
diff --git a/src/research/source-policy.ts b/src/research/source-policy.ts
new file mode 100644
index 0000000..062506c
--- /dev/null
+++ b/src/research/source-policy.ts
@@ -0,0 +1,95 @@
+import type { NormalizedVehicle } from "@/analysis/normalize";
+import type { SourceClass } from "@/domain/analysis";
+import type { ResearchClaimKind } from "@/research/cache-key";
+
+export type ResearchKind = ResearchClaimKind | "identity" | "history" | "maintenance" | "repair_context";
+export const EVIDENCE_APPLICABILITY_VALUES = [
+  "exact",
+  "model",
+  "background",
+  "needs_confirmation",
+  "unverified_input",
+] as const;
+
+export type EvidenceApplicability = (typeof EVIDENCE_APPLICABILITY_VALUES)[number];
+
+export interface ResearchSource {
+  sourceClass: SourceClass;
+  kind: ResearchKind;
+  make?: string;
+  model?: string;
+  generation?: string;
+  engine?: string;
+  gearbox?: string;
+  yearRange?: string;
+  vinMatched?: boolean;
+}
+
+const ALL_SOURCE_CLASSES: readonly SourceClass[] = [
+  "official_registry",
+  "manufacturer",
+  "independent",
+  "forum",
+  "listing",
+  "seller",
+  "buyer",
+];
+
+const RANKED_SOURCE_CLASSES: Record<ResearchKind, readonly SourceClass[]> = {
+  identity: ["official_registry", "manufacturer", "independent", "forum", "listing", "seller", "buyer"],
+  history: ["official_registry", "manufacturer", "independent", "forum", "listing", "seller", "buyer"],
+  recall: ["manufacturer", "official_registry", "independent", "forum", "listing", "seller", "buyer"],
+  maintenance: ["manufacturer", "official_registry", "independent", "forum", "listing", "seller", "buyer"],
+  repair_context: ["independent", "manufacturer", "official_registry", "forum", "listing", "seller", "buyer"],
+  common_issue: ["independent", "manufacturer", "official_registry", "forum", "listing", "seller", "buyer"],
+};
+
+function sameDimension(left: string | undefined, right: string | undefined): boolean {
+  return Boolean(left && right && left.trim().toLocaleLowerCase("en") === right.trim().toLocaleLowerCase("en"));
+}
+
+function isUnverifiedInput(sourceClass: SourceClass): boolean {
+  return sourceClass === "listing" || sourceClass === "seller" || sourceClass === "buyer";
+}
+
+function matchesYearRange(yearRange: string | undefined, year: number | undefined): boolean {
+  if (yearRange === undefined) return true;
+  if (!Number.isSafeInteger(year)) return false;
+
+  const match = yearRange.trim().match(/^(\d{4})(?:\s*-\s*(\d{4}))?$/);
+  if (!match) return false;
+
+  const vehicleYear = year as number;
+  const start = Number(match[1]);
+  const end = Number(match[2] ?? match[1]);
+  return start <= end && vehicleYear >= start && vehicleYear <= end;
+}
+
+function matchesSuppliedDimensions(source: ResearchSource, vehicle: NormalizedVehicle): boolean {
+  return (!source.make || sameDimension(source.make, vehicle.make))
+    && (!source.model || sameDimension(source.model, vehicle.model))
+    && (!source.generation || sameDimension(source.generation, vehicle.generation))
+    && (!source.engine || sameDimension(source.engine, vehicle.engineVariant))
+    && (!source.gearbox || sameDimension(source.gearbox, vehicle.gearboxVariant))
+    && matchesYearRange(source.yearRange, vehicle.year);
+}
+
+export function rankSources(kind: ResearchKind): readonly SourceClass[] {
+  return RANKED_SOURCE_CLASSES[kind] ?? ALL_SOURCE_CLASSES;
+}
+
+export function classifyEvidence(source: ResearchSource, vehicle: NormalizedVehicle): EvidenceApplicability {
+  if (isUnverifiedInput(source.sourceClass)) return "unverified_input";
+  if (source.sourceClass === "forum") return "background";
+  if (!matchesSuppliedDimensions(source, vehicle)) return "background";
+  if (source.kind === "recall") return source.vinMatched && vehicle.vin ? "exact" : "needs_confirmation";
+
+  if (source.engine) {
+    return "exact";
+  }
+  if (source.gearbox) {
+    return "exact";
+  }
+  if (source.make && source.model) return "model";
+  return "background";
+}
diff --git a/src/server/access/analysis-access.ts b/src/server/access/analysis-access.ts
new file mode 100644
index 0000000..e8d0b24
--- /dev/null
+++ b/src/server/access/analysis-access.ts
@@ -0,0 +1,122 @@
+import { createHmac, timingSafeEqual } from "node:crypto";
+import { hashAccessToken } from "@/server/access/tokens";
+import type { AnalysesRepository } from "@/server/repositories/analyses";
+
+const TOKEN_BYTES = 32;
+const DIGEST_BYTES = 32;
+
+interface VerifyCookieInput {
+  cookie: string;
+  persistedTokenHash: string;
+  publicId: string;
+  secret: string;
+}
+
+interface VerifyAccessInput {
+  cookie: string | undefined;
+  publicId: string;
+}
+
+interface VerifyAccessDependencies {
+  analyses: Pick<AnalysesRepository, "loadAccessTokenHash">;
+  secret: string;
+}
+
+async function defaultVerifyAccessDependencies(): Promise<VerifyAccessDependencies> {
+  const [{ getServerEnv }, { getServerSupabaseClient }, { AnalysesRepository }] =
+    await Promise.all([
+      import("@/config/env"),
+      import("@/server/db/client"),
+      import("@/server/repositories/analyses"),
+    ]);
+
+  return {
+    analyses: new AnalysesRepository(getServerSupabaseClient()),
+    secret: getServerEnv().ANALYSIS_COOKIE_SECRET,
+  };
+}
+
+function decodeCanonicalBase64Url(value: string): Buffer | null {
+  if (!/^[A-Za-z0-9_-]+$/.test(value)) return null;
+
+  const decoded = Buffer.from(value, "base64url");
+  return decoded.toString("base64url") === value ? decoded : null;
+}
+
+function decodeSha256Hex(value: string): Buffer | null {
+  if (!/^[a-f0-9]{64}$/.test(value)) return null;
+  return Buffer.from(value, "hex");
+}
+
+function equalLengthSafe(left: Buffer, right: Buffer): boolean {
+  return left.length === right.length && timingSafeEqual(left, right);
+}
+
+function signatureFor(publicId: string, rawToken: string, secret: string): Buffer {
+  return createHmac("sha256", secret).update(publicId).update("\0").update(rawToken).digest();
+}
+
+export function analysisAccessCookieName(publicId: string): string {
+  return `kontroll_access_${publicId}`;
+}
+
+export function verifyRawAnalysisToken(rawToken: string, persistedTokenHash: string): boolean {
+  const rawBytes = decodeCanonicalBase64Url(rawToken);
+  const persistedHash = decodeSha256Hex(persistedTokenHash);
+  if (rawBytes?.length !== TOKEN_BYTES || persistedHash?.length !== DIGEST_BYTES) return false;
+
+  const candidateHash = decodeSha256Hex(hashAccessToken(rawToken));
+  return candidateHash !== null && equalLengthSafe(candidateHash, persistedHash);
+}
+
+export function createAnalysisAccessCookie(
+  publicId: string,
+  rawToken: string,
+  secret: string,
+): string {
+  const rawBytes = decodeCanonicalBase64Url(rawToken);
+  if (rawBytes?.length !== TOKEN_BYTES) throw new Error("Invalid analysis access token");
+
+  const signature = signatureFor(publicId, rawToken, secret).toString("base64url");
+  return `${rawToken}.${signature}`;
+}
+
+export function verifyAnalysisAccessCookie({
+  cookie,
+  persistedTokenHash,
+  publicId,
+  secret,
+}: VerifyCookieInput): boolean {
+  const parts = cookie.split(".");
+  if (parts.length !== 2) return false;
+
+  const [rawToken, encodedSignature] = parts;
+  if (!rawToken || !encodedSignature) return false;
+
+  const rawBytes = decodeCanonicalBase64Url(rawToken);
+  const signature = decodeCanonicalBase64Url(encodedSignature);
+  if (rawBytes?.length !== TOKEN_BYTES || signature?.length !== DIGEST_BYTES) return false;
+
+  const expectedSignature = signatureFor(publicId, rawToken, secret);
+  if (!equalLengthSafe(signature, expectedSignature)) return false;
+
+  return verifyRawAnalysisToken(rawToken, persistedTokenHash);
+}
+
+export async function verifyAnalysisAccess(
+  { cookie, publicId }: VerifyAccessInput,
+  dependencies?: VerifyAccessDependencies,
+): Promise<boolean> {
+  if (!cookie) return false;
+
+  const resolvedDependencies = dependencies ?? (await defaultVerifyAccessDependencies());
+  const persistedTokenHash = await resolvedDependencies.analyses.loadAccessTokenHash(publicId);
+  if (!persistedTokenHash) return false;
+
+  return verifyAnalysisAccessCookie({
+    cookie,
+    persistedTokenHash,
+    publicId,
+    secret: resolvedDependencies.secret,
+  });
+}
diff --git a/src/server/access/tokens.ts b/src/server/access/tokens.ts
new file mode 100644
index 0000000..f702d2d
--- /dev/null
+++ b/src/server/access/tokens.ts
@@ -0,0 +1,16 @@
+import { createHash, randomBytes } from "node:crypto";
+
+export interface AccessToken {
+  raw: string;
+  hash: string;
+}
+
+export function hashAccessToken(raw: string): string {
+  return createHash("sha256").update(raw, "utf8").digest("hex");
+}
+
+export function createAccessToken(): AccessToken {
+  const raw = randomBytes(32).toString("base64url");
+
+  return { raw, hash: hashAccessToken(raw) };
+}
