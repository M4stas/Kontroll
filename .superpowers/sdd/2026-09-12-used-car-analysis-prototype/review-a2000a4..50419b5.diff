+  --popover: var(--blue-gray);
+  --popover-foreground: var(--off-white);
+  --primary: var(--pale-blue);
+  --primary-foreground: var(--ink-navy);
+  --secondary: var(--blue-gray);
+  --secondary-foreground: var(--off-white);
+  --muted: var(--blue-gray);
+  --muted-foreground: var(--steel);
+  --accent: var(--amber);
+  --accent-foreground: var(--ink-navy);
+  --destructive: var(--amber);
+  --border: var(--steel);
+  --input: var(--steel);
+  --ring: var(--pale-blue);
+  --chart-1: var(--pale-blue);
