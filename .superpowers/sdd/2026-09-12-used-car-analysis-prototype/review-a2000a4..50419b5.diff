+++ b/src/server/repositories/research.ts
@@ -0,0 +1,91 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+
+export interface ResearchCacheEntry<TResult = unknown, TSourceRef = unknown> {
+  cacheKey: string;
+  make: string;
+  model: string;
+  generation: string | null;
+  engine: string | null;
+  gearbox: string | null;
+  yearRange: string | null;
+  mileageBand: string | null;
+  result: TResult;
+  sourceRefs: TSourceRef[];
+  schemaVersion: number;
+  fetchedAt: string;
+  expiresAt: string;
+}
+
+interface ResearchCacheRow {
+  cache_key: string;
+  make: string;
+  model: string;
+  generation: string | null;
+  engine: string | null;
+  gearbox: string | null;
+  year_range: string | null;
+  mileage_band: string | null;
+  result: unknown;
+  source_refs: unknown[];
+  schema_version: number;
+  fetched_at: string;
+  expires_at: string;
+}
+
+function mapResearch<TResult, TSourceRef>(row: ResearchCacheRow): ResearchCacheEntry<TResult, TSourceRef> {
+  return {
+    cacheKey: row.cache_key,
+    make: row.make,
+    model: row.model,
+    generation: row.generation,
+    engine: row.engine,
+    gearbox: row.gearbox,
+    yearRange: row.year_range,
+    mileageBand: row.mileage_band,
+    result: row.result as TResult,
+    sourceRefs: row.source_refs as TSourceRef[],
+    schemaVersion: row.schema_version,
+    fetchedAt: row.fetched_at,
+    expiresAt: row.expires_at,
+  };
+}
+
+export class ResearchRepository {
+  constructor(private readonly client: SupabaseClient) {}
+
+  async findFresh<TResult = unknown, TSourceRef = unknown>(
+    cacheKey: string,
+    now = new Date(),
+  ): Promise<ResearchCacheEntry<TResult, TSourceRef> | null> {
+    const { data, error } = await this.client
+      .from("vehicle_research_cache")
+      .select("*")
+      .eq("cache_key", cacheKey)
+      .gt("expires_at", now.toISOString())
+      .maybeSingle();
+    if (error) throw new Error("Could not load vehicle research cache", { cause: error });
+    return data ? mapResearch<TResult, TSourceRef>(data as ResearchCacheRow) : null;
+  }
+
+  async put<TResult, TSourceRef>(entry: ResearchCacheEntry<TResult, TSourceRef>): Promise<void> {
+    const { error } = await this.client.from("vehicle_research_cache").upsert(
+      {
+        cache_key: entry.cacheKey,
+        make: entry.make,
+        model: entry.model,
+        generation: entry.generation,
+        engine: entry.engine,
+        gearbox: entry.gearbox,
+        year_range: entry.yearRange,
+        mileage_band: entry.mileageBand,
+        result: entry.result,
+        source_refs: entry.sourceRefs,
+        schema_version: entry.schemaVersion,
+        fetched_at: entry.fetchedAt,
+        expires_at: entry.expiresAt,
+      },
+      { onConflict: "cache_key" },
+    );
+    if (error) throw new Error("Could not save vehicle research cache", { cause: error });
+  }
+}
diff --git a/src/server/storage/uploads.ts b/src/server/storage/uploads.ts
new file mode 100644
index 0000000..a77a349
--- /dev/null
+++ b/src/server/storage/uploads.ts
@@ -0,0 +1,126 @@
+import { randomUUID } from "node:crypto";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { fileTypeFromBuffer } from "file-type";
+import sharp from "sharp";
+import { z } from "zod";
+
+const BUCKET = "analysis-uploads";
+const MAX_UPLOAD_BYTES = 12 * 1024 * 1024;
+const SIGNED_URL_SECONDS = 10 * 60;
+const ALLOWED_MIME_TYPES = new Set([
+  "image/jpeg",
+  "image/png",
+  "image/webp",
+  "application/pdf",
+]);
+const analysisIdSchema = z.string().uuid();
+
+function requireAnalysisId(analysisId: string): string {
+  if (!analysisIdSchema.safeParse(analysisId).success) {
+    throw new Error("Analysis ID must be a valid UUID");
+  }
+  return analysisId;
+}
+
+export interface UploadFile {
+  name: string;
+  type: string;
+  size: number;
+  arrayBuffer(): Promise<ArrayBuffer>;
+}
+
+export interface StoredUpload {
+  storageKey: string;
+  mimeType: string;
+  size: number;
+}
+
+async function stripImageMetadata(bytes: Uint8Array, mimeType: string): Promise<Uint8Array> {
+  const image = sharp(bytes).rotate();
+  switch (mimeType) {
+    case "image/jpeg":
+      return new Uint8Array(await image.jpeg().toBuffer());
+    case "image/png":
+      return new Uint8Array(await image.png().toBuffer());
+    case "image/webp":
+      return new Uint8Array(await image.webp().toBuffer());
+    default:
+      return bytes;
+  }
+}
+
+export class AnalysisUploads {
+  constructor(private readonly client: SupabaseClient) {}
+
+  async upload(analysisId: string, file: UploadFile): Promise<StoredUpload> {
+    const validAnalysisId = requireAnalysisId(analysisId);
+    if (file.size > MAX_UPLOAD_BYTES) {
+      throw new Error("Upload exceeds the 12 MiB file limit");
+    }
+    if (!ALLOWED_MIME_TYPES.has(file.type)) {
+      throw new Error("Upload type must be JPEG, PNG, WebP, or PDF");
+    }
+
+    const bytes = new Uint8Array(await file.arrayBuffer());
+    if (bytes.byteLength > MAX_UPLOAD_BYTES) {
+      throw new Error("Upload exceeds the 12 MiB file limit");
+    }
+
+    const detected = await fileTypeFromBuffer(bytes);
+    if (!detected || detected.mime !== file.type || !ALLOWED_MIME_TYPES.has(detected.mime)) {
+      throw new Error("Upload content does not match its allowed MIME type");
+    }
+
+    const persistedBytes = detected.mime.startsWith("image/")
+      ? await stripImageMetadata(bytes, detected.mime)
+      : bytes;
+    if (persistedBytes.byteLength > MAX_UPLOAD_BYTES) {
+      throw new Error("Upload exceeds the 12 MiB file limit after image processing");
+    }
+
+    const storageKey = `${validAnalysisId}/${randomUUID()}.${detected.ext}`;
+    const { error } = await this.client.storage.from(BUCKET).upload(storageKey, persistedBytes, {
+      contentType: detected.mime,
+      upsert: false,
+    });
+    if (error) throw new Error("Could not store analysis upload", { cause: error });
+
+    return { storageKey, mimeType: detected.mime, size: persistedBytes.byteLength };
+  }
+
+  async remove(analysisId: string, storageKeys: string[]): Promise<void> {
+    const validAnalysisId = requireAnalysisId(analysisId);
+    const requiredPrefix = `${validAnalysisId}/`;
+    if (storageKeys.some((key) => !key.startsWith(requiredPrefix) || key.length === requiredPrefix.length)) {
+      throw new Error("Storage key does not belong to the authorized analysis");
+    }
+    if (storageKeys.length === 0) return;
+
+    const { error } = await this.client.storage.from(BUCKET).remove(storageKeys);
+    if (error) throw new Error("Could not remove analysis upload", { cause: error });
+  }
+
+  async createSignedReadUrl(analysisId: string, storageKey: string): Promise<string> {
+    return (await this.createSignedRead(analysisId, storageKey)).signedUrl;
+  }
+
+  async createSignedRead(
+    analysisId: string,
+    storageKey: string,
+  ): Promise<{ signedUrl: string; expiresAt: string }> {
+    const validAnalysisId = requireAnalysisId(analysisId);
+    const requiredPrefix = `${validAnalysisId}/`;
+    if (!storageKey.startsWith(requiredPrefix) || storageKey.length === requiredPrefix.length) {
+      throw new Error("Storage key does not belong to the authorized analysis");
+    }
+
+    const { data, error } = await this.client.storage
+      .from(BUCKET)
+      .createSignedUrl(storageKey, SIGNED_URL_SECONDS);
+    if (error) throw new Error("Could not sign analysis upload URL", { cause: error });
+    return {
+      signedUrl: data.signedUrl,
+      expiresAt: new Date(Date.now() + (SIGNED_URL_SECONDS * 1000)).toISOString(),
+    };
+  }
+}
diff --git a/src/worker/index.ts b/src/worker/index.ts
new file mode 100644
index 0000000..83b14ff
--- /dev/null
+++ b/src/worker/index.ts
@@ -0,0 +1,49 @@
+import type { AnalysisJob } from "@/server/repositories/jobs";
+
+const DEFAULT_LEASE_SECONDS = 60;
+const IDLE_WAIT_MS = 1_000;
+
+export interface WorkerLoopDependencies {
+  workerId: string;
+  leaseSeconds?: number;
+  lease(workerId: string, leaseSeconds: number): Promise<AnalysisJob | null>;
+  process(job: AnalysisJob): Promise<void>;
+  wait?: (milliseconds: number) => Promise<void>;
+}
+
+function wait(milliseconds: number): Promise<void> {
+  return new Promise((resolve) => setTimeout(resolve, milliseconds));
+}
+
+export async function runWorkerLoop(
+  deps: WorkerLoopDependencies,
+  signal: AbortSignal,
+): Promise<void> {
+  const idleWait = deps.wait ?? wait;
+
+  while (!signal.aborted) {
+    const job = await deps.lease(
+      deps.workerId,
+      deps.leaseSeconds ?? DEFAULT_LEASE_SECONDS,
+    );
+
+    if (job) {
+      await deps.process(job);
+      continue;
+    }
+
+    if (!signal.aborted) await idleWait(IDLE_WAIT_MS);
+  }
+}
+
+export async function runUntilSigterm(deps: WorkerLoopDependencies): Promise<void> {
+  const controller = new AbortController();
+  const stop = () => controller.abort();
+  process.once("SIGTERM", stop);
+
+  try {
+    await runWorkerLoop(deps, controller.signal);
+  } finally {
+    process.off("SIGTERM", stop);
+  }
+}
diff --git a/src/worker/process-job.ts b/src/worker/process-job.ts
new file mode 100644
index 0000000..6d51d17
--- /dev/null
+++ b/src/worker/process-job.ts
@@ -0,0 +1,185 @@
+import {
+  isAnalysisStage,
+  LONG_RUNNING_STAGES,
+  STAGE_DEPENDENTS,
+  type AnalysisStage,
+  type StageExecutionResult,
+} from "@/analysis/stages";
+import type { AnalysisJob } from "@/server/repositories/jobs";
+
+const RETRY_DELAYS_MS = [15_000, 60_000, 300_000] as const;
+const MAX_INFRASTRUCTURE_RETRY_DELAY_MS = 300_000;
+const LEASE_SECONDS = 60;
+const RENEW_INTERVAL_MS = 30_000;
+const OPTIONAL_REPORT_STAGES: ReadonlySet<AnalysisStage> = new Set([
+  "research",
+  "enrich",
+]);
+
+interface EnqueueJob {
+  analysisId: string;
+  runId: string;
+  stage: AnalysisStage;
+}
+
+export interface WorkerDependencies {
+  workerId: string;
+  jobs: {
+    complete(jobId: string, workerId: string): Promise<void>;
+    enqueue(job: EnqueueJob): Promise<void>;
+    fail(jobId: string, workerId: string, message: string): Promise<void>;
+    renew(jobId: string, workerId: string, leaseSeconds: number): Promise<void>;
+    retry(
+      jobId: string,
+      workerId: string,
+      availableAt: Date,
+      message: string,
+    ): Promise<void>;
+  };
+  stages: Record<AnalysisStage, (job: AnalysisJob) => Promise<void | StageExecutionResult>>;
+  now?: () => Date;
+}
+
+interface TransientError extends Error {
+  transient: true;
+}
+
+class WorkerInfrastructureError extends Error {
+  constructor(cause: unknown) {
+    super(errorMessage(cause), { cause });
+  }
+}
+
+function isTransientError(error: unknown): error is TransientError {
+  return error instanceof Error && "transient" in error && error.transient === true;
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
+
+async function enqueueDependents(
+  job: AnalysisJob,
+  stages: readonly AnalysisStage[],
+  deps: WorkerDependencies,
+): Promise<void> {
+  for (const stage of stages) {
+    await deps.jobs.enqueue({
+      analysisId: job.analysisId,
+      runId: job.runId,
+      stage,
+    });
+  }
+}
+
+async function executeStage(
+  job: AnalysisJob,
+  stage: AnalysisStage,
+  deps: WorkerDependencies,
+): Promise<void | StageExecutionResult> {
+  if (!LONG_RUNNING_STAGES.has(stage)) {
+    return deps.stages[stage](job);
+  }
+
+  let renewalFailure: unknown;
+  let renewalInFlight: Promise<void> = Promise.resolve();
+  let renewing = false;
+  const renewal = setInterval(() => {
+    if (renewing || renewalFailure !== undefined) return;
+    renewing = true;
+    renewalInFlight = deps.jobs
+      .renew(job.id, deps.workerId, LEASE_SECONDS)
+      .catch((error: unknown) => {
+        renewalFailure = error;
+      })
+      .finally(() => {
+        renewing = false;
+      });
+  }, RENEW_INTERVAL_MS);
+
+  let stageResult: void | StageExecutionResult;
+  try {
+    stageResult = await deps.stages[stage](job);
+  } finally {
+    clearInterval(renewal);
+    await renewalInFlight;
+  }
+
+  if (renewalFailure !== undefined) throw new WorkerInfrastructureError(renewalFailure);
+  return stageResult;
+}
+
+async function retryInfrastructureFailure(
+  job: AnalysisJob,
+  error: unknown,
+  deps: WorkerDependencies,
+): Promise<void> {
+  const retryDelay =
+    RETRY_DELAYS_MS[job.attempts - 1] ?? MAX_INFRASTRUCTURE_RETRY_DELAY_MS;
+  const now = deps.now?.() ?? new Date();
+  await deps.jobs.retry(
+    job.id,
+    deps.workerId,
+    new Date(now.getTime() + retryDelay),
+    errorMessage(error),
+  );
+}
+
+async function handleStageFailure(
+  job: AnalysisJob & { stage: AnalysisStage },
+  error: unknown,
+  deps: WorkerDependencies,
+): Promise<void> {
+  const message = errorMessage(error);
+  const retryDelay = RETRY_DELAYS_MS[job.attempts - 1];
+
+  if (isTransientError(error) && retryDelay !== undefined) {
+    const now = deps.now?.() ?? new Date();
+    await deps.jobs.retry(job.id, deps.workerId, new Date(now.getTime() + retryDelay), message);
+    return;
+  }
+
+  if (isTransientError(error) || OPTIONAL_REPORT_STAGES.has(job.stage)) {
+    try {
+      await enqueueDependents(job, job.stage === "research" ? ["enrich"] : ["assemble_report"], deps);
+    } catch (enqueueError) {
+      await retryInfrastructureFailure(job, enqueueError, deps);
+      return;
+    }
+  }
+
+  await deps.jobs.fail(job.id, deps.workerId, message);
+}
+
+export async function processJob(
+  job: AnalysisJob,
+  deps: WorkerDependencies,
+): Promise<void> {
+  if (!isAnalysisStage(job.stage)) {
+    await deps.jobs.fail(job.id, deps.workerId, `Unknown analysis stage: ${job.stage}`);
+    return;
+  }
+
+  let stageResult: void | StageExecutionResult;
+  try {
+    stageResult = await executeStage(job, job.stage, deps);
+  } catch (error) {
+    if (error instanceof WorkerInfrastructureError) {
+      await retryInfrastructureFailure(job, error, deps);
+      return;
+    }
+
+    await handleStageFailure(job as AnalysisJob & { stage: AnalysisStage }, error, deps);
+    return;
+  }
+
+  try {
+    const dependents = job.stage === "assemble_report"
+      ? stageResult?.enqueueDependents === true ? STAGE_DEPENDENTS[job.stage] : []
+      : STAGE_DEPENDENTS[job.stage];
+    await enqueueDependents(job, dependents, deps);
+    await deps.jobs.complete(job.id, deps.workerId);
+  } catch (error) {
+    await retryInfrastructureFailure(job, error, deps);
+  }
+}
