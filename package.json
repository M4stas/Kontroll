{
  "name": "kontroll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm build:sw && next dev",
    "build": "pnpm build:sw && next build --webpack",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint .",
    "typecheck": "pnpm build:sw && next typegen && tsc --noEmit && tsc --noEmit -p src/service-worker",
    "test": "vitest run",
    "worker": "tsx scripts/worker.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:sw": "tsx scripts/build-sw.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@next/env": "^16.3.8",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "8.6.0",
    "embla-carousel-wheel-gestures": "8.1.0",
    "file-type": "^22.1.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.4",
    "openai": "^7.15.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
